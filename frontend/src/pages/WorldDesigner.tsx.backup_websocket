                  label: 'Path',
                  children: (
                    <Space direction="vertical" style={{ width: '100%' }} size="middle">
                      <Select
                        placeholder="Path agent"
                        options={agentOptions}
                        value={selectedAgentId || undefined}
                        onChange={v => setSelectedAgentId(v)}
                        allowClear
                        style={{ width: '100%' }}
                      />
                      <Text type="secondary">Set target with Mode = Set Target, then click a cell.</Text>
                      <Button onClick={() => selectedAgentId && doPlanPath(selectedAgentId)} disabled={!selectedAgentId} block>Plan Path</Button>
                      <Button type="primary" onClick={() => selectedAgentId && doMoveToTarget(selectedAgentId)} disabled={!selectedAgentId} block>Move To Target</Button>
                    </Space>
                  ),
                },
                {
                  key: 'ai',
                  label: 'AI Paint',
                  children: (
                    <Space direction="vertical" style={{ width: '100%' }} size="middle">
                      <Text type="secondary">AI 会在当前 viewport 内协作绘制（Planner→脚本/宏，Painter→细化）。</Text>
                      <Input.TextArea rows={4} value={aiPrompt} onChange={(e) => setAiPrompt(e.target.value)} placeholder="Describe what to draw in the current viewport" />
                      <Segmented
                        block
                        options={[
                          { label: 'Text→Grid', value: 'text' },
                          { label: 'Text→Image→Grid (AI_4)', value: 'image' },
                        ]}
                        value={aiPipeline}
                        onChange={(v) => setAiPipeline(v as 'text' | 'image')}
                      />
                      <Button type="primary" onClick={() => doAIDraw(aiPrompt)} loading={creating} block>
                        Run AI
                      </Button>
                      <Button onClick={doRandomizeRedBlue} loading={creating} block>
                        Randomize Floor: Blue/Red (Current View)
                      </Button>
                    </Space>
                  ),
                },
              ]}
            />
          </Card>
        </Col>
      </Row>
    </div>
  );
};

export default WorldDesigner;
