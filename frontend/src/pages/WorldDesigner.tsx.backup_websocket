import React, { useEffect, useMemo, useRef, useState } from 'react';
import { Button, Card, Col, Divider, Form, Input, InputNumber, message, Row, Select, Segmented, Space, Switch, Tabs, Typography, theme } from 'antd';
import { EnvironmentOutlined, PlusOutlined, ReloadOutlined } from '@ant-design/icons';
import type { Agent, SimulationHistoryItem, SimulationStep } from '../api/agent';
import { createAgent, getAgents, injectMemory, runSimulationStep } from '../api/agent';
import type { World, WorldColorLabel, WorldIdentity, WorldPOIKind, WorldViewResponse } from '../api/world';
import { aiGenerateWorld, aiImageWorld, createWorld, createWorldIdentity, createWorldPOI, deleteWorldIdentity, deleteWorldPOI, drawWorld, getWorld, getWorldAscii, getWorldView, listWorlds, moveAgentInWorld, placeAgentInWorld, planPath, planPathToPOI, pickPOIPath, setWorldAgentIdentity, updateWorldIdentity, worldEncounterDialogue } from '../api/world';

const { Text } = Typography;

type Mode = 'paint_wall' | 'paint_color' | 'place_agent' | 'set_target' | 'draw_poi_rect';

const CELL_SIZE = 16;

function isInPath(path: Array<{ x: number; y: number }>, x: number, y: number): boolean {
  return path.some(p => p.x === x && p.y === y);
}

const WorldDesigner: React.FC = () => {
  const { token } = theme.useToken();

  const [agents, setAgents] = useState<Agent[]>([]);
  const [worlds, setWorlds] = useState<World[]>([]);
  const [world, setWorld] = useState<World | null>(null);
  const [selectedWorldId, setSelectedWorldId] = useState<string | null>(null);

  const [view, setView] = useState<WorldViewResponse | null>(null);
  const [viewX, setViewX] = useState(0);
  const [viewY, setViewY] = useState(0);
  const [viewW, setViewW] = useState(80);
  const [viewH, setViewH] = useState(50);

  const [zoom, setZoom] = useState<number>(1);
  const zoomRef = useRef<number>(1);
  const [spacePressed, setSpacePressed] = useState(false);
  const [isPanning, setIsPanning] = useState(false);
  const panRef = useRef<{
    active: boolean;
    startClientX: number;
    startClientY: number;
    startViewX: number;
    startViewY: number;
    lastDx: number;
    lastDy: number;
  }>({
    active: false,
    startClientX: 0,
    startClientY: 0,
    startViewX: 0,
    startViewY: 0,
    lastDx: 0,
    lastDy: 0,
  });
  const [panPx, setPanPx] = useState<{ x: number; y: number }>({ x: 0, y: 0 });
  const viewBoxRef = useRef<{ x: number; y: number; w: number; h: number }>({ x: 0, y: 0, w: 80, h: 50 });

  const [mode, setMode] = useState<Mode>('paint_wall');
  const [wallBrush, setWallBrush] = useState<boolean>(true);
  const [colorBrush, setColorBrush] = useState<WorldColorLabel>('neutral');

  const [selectedAgentId, setSelectedAgentId] = useState<string | null>(null);
  const [selectedIdentityId, setSelectedIdentityId] = useState<string | null>(null);

  const [poiRectName, setPoiRectName] = useState<string>('');
  const [poiRectKind, setPoiRectKind] = useState<WorldPOIKind>('custom');
  const [poiRectLabel, setPoiRectLabel] = useState<WorldColorLabel | null>('neutral');
  const [poiRectDraft, setPoiRectDraft] = useState<{ x0: number; y0: number; x1: number; y1: number } | null>(null);
  const poiRectDraggingRef = useRef(false);
  const poiRectStartRef = useRef<{ x: number; y: number } | null>(null);
  const [poiSelectedId, setPoiSelectedId] = useState<string | null>(null);

  const [identityEditorId, setIdentityEditorId] = useState<string | null>(null);
  const [identityName, setIdentityName] = useState<string>('');
  const [identityKind, setIdentityKind] = useState<'student' | 'teacher' | 'custom'>('custom');
  const [identityDescription, setIdentityDescription] = useState<string>('');
  const [identityScheduleJson, setIdentityScheduleJson] = useState<string>('[]');
  const [identitySaving, setIdentitySaving] = useState(false);

  const [target, setTarget] = useState<{ x: number; y: number } | null>(null);
  const [path, setPath] = useState<Array<{ x: number; y: number }>>([]);

  const [creating, setCreating] = useState(false);
  const [loading, setLoading] = useState(false);

  const [memAgentId, setMemAgentId] = useState<string | null>(null);
  const [memText, setMemText] = useState('');
  const [memImportance, setMemImportance] = useState<number>(3);

  const [dlgInitiator, setDlgInitiator] = useState<string | null>(null);
  const [dlgPartner, setDlgPartner] = useState<string>('');
  const [dlgMaxTurns, setDlgMaxTurns] = useState<number>(6);
  const [dlgEndMarker, setDlgEndMarker] = useState<string>('END_DIALOGUE');
  const [dlgPrompt, setDlgPrompt] = useState<string>('Start a conversation in this world. When finished, output END_DIALOGUE.');
  const [dlgOutput, setDlgOutput] = useState<string>('');

  const [aiPrompt, setAiPrompt] = useState<string>('Draw a campus map in the current viewport with semantic color zones: cafeteria=warning, dorm=error, classrooms=info, library=primary, sports field=success, roads/plaza=neutral. Use walls to block buildings but leave walkable paths.');
  const [aiPipeline, setAiPipeline] = useState<'text' | 'image'>('text');

  const [autoRoam, setAutoRoam] = useState(false);
  const [bubbleByAgent, setBubbleByAgent] = useState<Record<string, { text: string; expiresAt: number }>>({});
  const [worldTimeText, setWorldTimeText] = useState<string>('08:00');
  const roamTickRef = useRef<number | null>(null);
  const roamTickInFlightRef = useRef(false);
  const encounterCooldownRef = useRef<Map<string, number>>(new Map());
  const encounterInFlightRef = useRef<Set<string>>(new Set());
  const worldClockMsRef = useRef<number>(8 * 60 * 60 * 1000); // 08:00
  const homeByAgentRef = useRef<Map<string, { x: number; y: number }>>(new Map());
  const roamIntentByAgentRef = useRef<
    Map<
      string,
      {
        activity: string;
        target: { x: number; y: number };
        path: Array<{ x: number; y: number }>;
        pathIndex: number;
        expiresAtMs: number;
        arrived?: boolean;
      }
    >
  >(new Map());
  const worldRef = useRef<World | null>(null);
  const viewRef = useRef<WorldViewResponse | null>(null);
  const agentsRef = useRef<Agent[]>([]);

  const [worldForm] = Form.useForm();
  const [agentForm] = Form.useForm();

  useEffect(() => {
    zoomRef.current = zoom;
  }, [zoom]);

  useEffect(() => {
    viewBoxRef.current = { x: viewX, y: viewY, w: viewW, h: viewH };
  }, [viewX, viewY, viewW, viewH]);

  useEffect(() => {
    const shouldIgnoreKey = () => {
      const el = document.activeElement as HTMLElement | null;
      const tag = (el?.tagName || '').toLowerCase();
      return tag === 'input' || tag === 'textarea' || (el as any)?.isContentEditable;
    };

    const onKeyDown = (e: KeyboardEvent) => {
      if (e.code !== 'Space') return;
      if (shouldIgnoreKey()) return;
      e.preventDefault();
      setSpacePressed(true);
    };
    const onKeyUp = (e: KeyboardEvent) => {
      if (e.code !== 'Space') return;
      setSpacePressed(false);
    };
    window.addEventListener('keydown', onKeyDown, { passive: false });
    window.addEventListener('keyup', onKeyUp);
    return () => {
      window.removeEventListener('keydown', onKeyDown as any);
      window.removeEventListener('keyup', onKeyUp as any);
    };
  }, []);

  const placementsByXY = useMemo(() => {
    const map = new Map<string, string>();
    (view?.agent_placements || []).forEach(p => {
      map.set(`${p.x},${p.y}`, p.agent_id);
    });
    return map;
  }, [view]);

  const agentNameById = useMemo(() => {
    const m = new Map<string, string>();
    agents.forEach(a => m.set(a.id, a.name));
    return m;
  }, [agents]);

  const poiLabelByXY = useMemo(() => {
    const m = new Map<string, { short: string; full: string; kind: string }>();
    const pois = world?.pois || [];
    for (const p of pois) {
      const shape = (p as any).shape || 'point';
      let ax = p.x;
      let ay = p.y;
      if (shape === 'cells') {
        const cells = (p as any).cells || [];
        if (cells?.length) {
          ax = Number(cells[0].x);
          ay = Number(cells[0].y);
        }
      }
      const full = (p.name || '').trim();
      if (!full) continue;
      const short = full.length <= 2 ? full : full.slice(0, 2);
      m.set(`${ax},${ay}`, { short, full, kind: String(p.kind || '') });
    }
    return m;
  }, [world?.pois]);

  const bubbleTextForAgent = (agentId: string | null | undefined) => {
    if (!agentId) return null;
    const b = bubbleByAgent[agentId];
    if (!b) return null;
    if (Date.now() > b.expiresAt) return null;
    return b.text;
  };

  const kindCn = (k: WorldPOIKind) => {
    if (k === 'cafeteria') return '食堂';
    if (k === 'dorm') return '寝室';
    if (k === 'classroom') return '教学楼/教室';
    if (k === 'library') return '图书馆';
    if (k === 'office') return '办公室';
    if (k === 'sports') return '操场/运动区';
    return '自定义区域';
  };

  const findPOIAt = (x: number, y: number) => {
    const wld = worldRef.current;
    const pois = wld?.pois || [];
    for (const p of pois) {
      const shape = (p as any).shape || 'point';
      if (shape === 'rect') {
        const w = Number((p as any).w || 0);
        const h = Number((p as any).h || 0);
        if (w > 0 && h > 0 && x >= p.x && x < p.x + w && y >= p.y && y < p.y + h) return p;
      } else if (shape === 'cells') {
        const cells = (p as any).cells || [];
        for (let i = 0; i < Math.min(cells.length, 1500); i++) {
          const c = cells[i];
          if (c?.x === x && c?.y === y) return p;
        }
      } else {
        if (p.x === x && p.y === y) return p;
      }
    }
    return null;
  };

  const isInDraftRect = (x: number, y: number) => {
    if (!poiRectDraft) return false;
    const x0 = Math.min(poiRectDraft.x0, poiRectDraft.x1);
    const y0 = Math.min(poiRectDraft.y0, poiRectDraft.y1);
    const x1 = Math.max(poiRectDraft.x0, poiRectDraft.x1);
    const y1 = Math.max(poiRectDraft.y0, poiRectDraft.y1);
    return x >= x0 && x <= x1 && y >= y0 && y <= y1;
  };

  const toAbs = (xLocal: number, yLocal: number) => {
    return { x: (view?.x || 0) + xLocal, y: (view?.y || 0) + yLocal };
  };

  const clampView = (w: World, x: number, y: number, vw: number, vh: number) => {
    const nx = Math.max(0, Math.min(x, Math.max(0, w.width - 1)));
    const ny = Math.max(0, Math.min(y, Math.max(0, w.height - 1)));
    const nw = Math.max(1, Math.min(vw, 200, w.width - nx));
    const nh = Math.max(1, Math.min(vh, 200, w.height - ny));
    return { x: nx, y: ny, w: nw, h: nh };
  };

  const loadView = async (wld: World, x: number, y: number, w: number, h: number) => {
    const clamped = clampView(wld, x, y, w, h);
    setViewX(clamped.x);
    setViewY(clamped.y);
    setViewW(clamped.w);
    setViewH(clamped.h);
    const v = await getWorldView(wld.id, clamped.x, clamped.y, clamped.w, clamped.h);
    setView(v);
  };

  const beginPan = (e: React.PointerEvent<HTMLDivElement>) => {
    if (!worldRef.current || !viewRef.current) return false;
    const wantsPan = spacePressed || e.button === 1 || e.button === 2;
    if (!wantsPan) return false;
    panRef.current.active = true;
    panRef.current.startClientX = e.clientX;
    panRef.current.startClientY = e.clientY;
    panRef.current.lastDx = 0;
    panRef.current.lastDy = 0;
    panRef.current.startViewX = viewBoxRef.current.x;
    panRef.current.startViewY = viewBoxRef.current.y;
    setIsPanning(true);
    setPanPx({ x: 0, y: 0 });
    try {
      (e.currentTarget as any).setPointerCapture?.(e.pointerId);
    } catch {
      // ignore
    }
    e.preventDefault();
    e.stopPropagation();
    return true;
  };

  const updatePan = (e: React.PointerEvent<HTMLDivElement>) => {
    if (!panRef.current.active) return;
    const dx = e.clientX - panRef.current.startClientX;
    const dy = e.clientY - panRef.current.startClientY;
    panRef.current.lastDx = dx;
    panRef.current.lastDy = dy;
    setPanPx({ x: dx, y: dy });
    e.preventDefault();
    e.stopPropagation();
  };

  const endPan = async (e: React.PointerEvent<HTMLDivElement>) => {
    if (!panRef.current.active) return;
    panRef.current.active = false;
    setIsPanning(false);

    const wld = worldRef.current;
    if (!wld) {
      setPanPx({ x: 0, y: 0 });
      return;
    }

    const cellPx = CELL_SIZE * (zoomRef.current || 1);
    const dxCells = cellPx > 0 ? Math.round(panRef.current.lastDx / cellPx) : 0;
    const dyCells = cellPx > 0 ? Math.round(panRef.current.lastDy / cellPx) : 0;

    // Drag map right -> see more left -> viewX decreases.
    const nextX = panRef.current.startViewX - dxCells;
    const nextY = panRef.current.startViewY - dyCells;
    setPanPx({ x: 0, y: 0 });

    if (nextX !== viewBoxRef.current.x || nextY !== viewBoxRef.current.y) {
      await loadView(wld, nextX, nextY, viewBoxRef.current.w, viewBoxRef.current.h);
    }

    e.preventDefault();
    e.stopPropagation();
  };

  const onWheelZoom = (e: React.WheelEvent<HTMLDivElement>) => {
    if (!worldRef.current || !viewRef.current) return;
    // Avoid page scrolling while zooming the map.
    e.preventDefault();
    e.stopPropagation();
    const dir = e.deltaY;
    const factor = dir < 0 ? 1.1 : 0.9;
    const next = Math.max(0.5, Math.min(3, (zoomRef.current || 1) * factor));
    setZoom(next);
  };

  const refreshAll = async () => {
    setLoading(true);
    try {
      const [agentsRes, worldsRes] = await Promise.all([getAgents(), listWorlds()]);
      setAgents(agentsRes);
      setWorlds(worldsRes);

      if (selectedWorldId) {
        const found = worldsRes.find(w => w.id === selectedWorldId);
        if (!found) {
          setSelectedWorldId(null);
          setWorld(null);
        }
      }
    } catch (e: any) {
      message.error(e?.response?.data?.detail || e?.message || 'Refresh failed');
    } finally {
      setLoading(false);
    }
  };

  useEffect(() => {
    refreshAll();
    // eslint-disable-next-line react-hooks/exhaustive-deps
  }, []);

  useEffect(() => {
    worldRef.current = world;
    // keep identity selection stable where possible
    if (world?.identities?.length) {
      const ids = new Set(world.identities.map(i => i.id));
      if (selectedIdentityId && ids.has(selectedIdentityId)) return;
      setSelectedIdentityId(world.identities[0].id);
    } else {
      setSelectedIdentityId(null);
    }
  }, [world]);

  useEffect(() => {
    viewRef.current = view;
  }, [view]);

  useEffect(() => {
    if (!world?.identities?.length) {
      setIdentityEditorId(null);
      setIdentityName('');
      setIdentityDescription('');
      setIdentityKind('custom');
      setIdentityScheduleJson('[]');
      return;
    }
    const ids = new Set(world.identities.map(i => i.id));
    const nextId = identityEditorId && ids.has(identityEditorId) ? identityEditorId : world.identities[0].id;
    setIdentityEditorId(nextId);
    const it = world.identities.find(i => i.id === nextId);
    if (it) {
      setIdentityName(it.name || '');
      setIdentityKind((it.kind as any) || 'custom');
      setIdentityDescription(it.description || '');
      setIdentityScheduleJson(JSON.stringify(it.schedule || [], null, 2));
    }
    // eslint-disable-next-line react-hooks/exhaustive-deps
  }, [world?.id, world?.identities]);

  useEffect(() => {
    viewRef.current = view;
  }, [view]);

  useEffect(() => {
    agentsRef.current = agents;
  }, [agents]);

  useEffect(() => {
    if (!autoRoam) {
      if (roamTickRef.current) {
        window.clearInterval(roamTickRef.current);
        roamTickRef.current = null;
      }
      return;
    }

    const tick = async () => {
      if (roamTickInFlightRef.current) return;
      roamTickInFlightRef.current = true;

      const w = worldRef.current;
      const v = viewRef.current;
      if (!w || !v) {
        roamTickInFlightRef.current = false;
        return;
      }

      try {
        const WORLD_MS_PER_TICK = 30 * 1000; // 0.9s real-time ~= 30s world-time
        const DAY_MS = 24 * 60 * 60 * 1000;
        worldClockMsRef.current = (worldClockMsRef.current + WORLD_MS_PER_TICK) % DAY_MS;

        const hh = Math.floor(worldClockMsRef.current / (60 * 60 * 1000));
        const mm = Math.floor((worldClockMsRef.current % (60 * 60 * 1000)) / (60 * 1000));
        const timeText = `${String(hh).padStart(2, '0')}:${String(mm).padStart(2, '0')}`;
        setWorldTimeText(timeText);

        const getIdentityFor = (agentId: string): WorldIdentity | null => {
          const wld = worldRef.current;
          const identities = wld?.identities || [];
          const mapping = wld?.agent_identities || {};
          const identityId = mapping?.[agentId];
          if (identityId) {
            const found = identities.find(i => i.id === identityId);
            if (found) return found;
          }
          return null;
        };

        const getFallbackKind = (agentId: string): 'teacher' | 'student' => {
          const a = agentsRef.current.find(x => x.id === agentId);
          const name = (a?.name || agentId || '').toLowerCase();
          if (name.includes('老师') || name.includes('teacher') || name.includes('prof')) return 'teacher';
          return 'student';
        };

        const scheduleFor = (agentId: string, hour: number): { activity: string; poiKinds: WorldPOIKind[] } => {
          const identity = getIdentityFor(agentId);
          if (identity?.schedule?.length) {
            const item = identity.schedule.find(s => hour >= s.start_hour && hour < s.end_hour) || null;
            if (item) return { activity: item.activity, poiKinds: item.poi_kinds || [] };
          }

          // fallback (legacy heuristic)
          const kind = getFallbackKind(agentId);
          if (kind === 'teacher') {
            if (hour < 9) return { activity: '去食堂吃早餐/准备授课', poiKinds: ['cafeteria'] };
            if (hour < 12) return { activity: '去教学楼上课/辅导学生', poiKinds: ['classroom'] };
            if (hour < 14) return { activity: '去食堂吃午饭/短暂休息', poiKinds: ['cafeteria'] };
            if (hour < 17) return { activity: '去办公室备课/答疑', poiKinds: ['office', 'library'] };
            if (hour < 19) return { activity: '去教学楼/图书馆进行研讨', poiKinds: ['classroom', 'library'] };
            return { activity: '回住处休息/整理教学计划', poiKinds: ['dorm'] };
          }
          if (hour < 9) return { activity: '去食堂吃早餐/准备开始一天', poiKinds: ['cafeteria'] };
          if (hour < 12) return { activity: '去教学楼上课/学习', poiKinds: ['classroom'] };
          if (hour < 14) return { activity: '去食堂吃午饭/短暂休息', poiKinds: ['cafeteria'] };
          if (hour < 18) return { activity: '去图书馆自习/做项目', poiKinds: ['library'] };
          if (hour < 20) return { activity: '去操场运动/散步放松', poiKinds: ['sports'] };
          return { activity: '回寝室休息/复盘一天', poiKinds: ['dorm'] };
        };

        const buildNewIntent = async (agentId: string, curX: number, curY: number) => {
          const sched = scheduleFor(agentId, hh);
          const activity = sched.activity;
          const home = homeByAgentRef.current.get(agentId) || { x: curX, y: curY };
          if (!homeByAgentRef.current.has(agentId)) {
            homeByAgentRef.current.set(agentId, home);
          }

          // If it's late, bias to returning "home".
          const forceHome = activity.startsWith('回寝室') || activity.startsWith('回住处') || activity.startsWith('回宿舍');

          const preferredLabels = (() => {
            // Legacy label fallback for worlds without named POIs.
            if (hh < 9) return ['warning'] as const;
            if (hh < 12) return ['info'] as const;
            if (hh < 14) return ['warning'] as const;
            if (hh < 18) return ['primary'] as const;
            if (hh < 20) return ['success', 'neutral'] as const;
            return ['error'] as const;
          })();

          const pickPOIByKind = (): { id: string; kind: WorldPOIKind } | null => {
            const wld = worldRef.current;
            const pois = wld?.pois || [];
            const kinds = sched.poiKinds || [];
            if (!pois.length || !kinds.length) return null;
            const matches = pois.filter(p => kinds.includes(p.kind));
            if (!matches.length) return null;
            matches.sort((a, b) => (Math.abs(a.x - curX) + Math.abs(a.y - curY)) - (Math.abs(b.x - curX) + Math.abs(b.y - curY)));
            return { id: matches[0].id, kind: matches[0].kind };
          };

          // Prefer named POIs + kind-based scheduling first.
          if (!forceHome) {
            const chosen = pickPOIByKind();
            if (chosen) {
              try {
                const res = await planPathToPOI(w.id, { agent_id: agentId, poi_id: chosen.id, max_radius: 8 });
                if (res?.path?.length >= 2) {
                  return {
                    activity,
                    target: { x: res.target.x, y: res.target.y },
                    path: res.path,
                    pathIndex: 0,
                    expiresAtMs: (worldClockMsRef.current + 2 * 60 * 60 * 1000) % DAY_MS,
                  };
                }
              } catch {
                // fall back
              }
            }
          }

          // Try POI-driven goal first (backend will pick a reachable target near POI cells).
          if (!forceHome) {
            try {
              const res = await pickPOIPath(w.id, {
                agent_id: agentId,
                labels: [...preferredLabels],
                strategy: 'nearest',
                max_seed_cells: 800,
                max_attempts: 60,
                max_radius: 8,
              });
              if (res?.path?.length >= 2) {
                return {
                  activity,
                  target: { x: res.target.x, y: res.target.y },
                  path: res.path,
                  pathIndex: 0,
                  // Intent expires in ~2 world-hours.
                  expiresAtMs: (worldClockMsRef.current + 2 * 60 * 60 * 1000) % DAY_MS,
                };
              }
            } catch {
              // fall back to random goal + planPath
            }
          }

          const tries = 6;
          for (let attempt = 0; attempt < tries; attempt++) {
            const tx = forceHome ? home.x : Math.floor(Math.random() * w.width);
            const ty = forceHome ? home.y : Math.floor(Math.random() * w.height);

            const dist = Math.abs(tx - curX) + Math.abs(ty - curY);
            if (!forceHome && (dist < 6 || dist > 80)) continue;

            try {
              const path = await planPath(w.id, agentId, tx, ty);
              if (!path || path.length < 2) continue;
              return {
                activity,
                target: { x: tx, y: ty },
                path,
                pathIndex: 0,
                // Intent expires in ~2 world-hours.
                expiresAtMs: (worldClockMsRef.current + 2 * 60 * 60 * 1000) % DAY_MS,
              };
            } catch {
              // try another target
            }
          }
          return null;
        };

        // Opportunistic bubble cleanup so state doesn't grow forever.
        const now = Date.now();
        setBubbleByAgent(prev => {
          let changed = false;
          const next: typeof prev = { ...prev };
          Object.entries(prev).forEach(([k, b]) => {
            if (now > b.expiresAt) {
              delete next[k];
              changed = true;
            }
          });
          return changed ? next : prev;
        });

        let placementsAll = (w.agent_placements || []) as any[];
        if (placementsAll.length === 0) return;

        // Ensure each agent has a "home" anchor (their first seen position).
        placementsAll.forEach(pp => {
          if (!homeByAgentRef.current.has(pp.agent_id)) {
            homeByAgentRef.current.set(pp.agent_id, { x: pp.x, y: pp.y });
          }
        });

        // Move several agents per tick so the campus feels alive.
        // Keep this small to avoid hammering the backend.
        const MAX_MOVES_PER_TICK = 4;

        const occ = new Set(placementsAll.map(pp => `${pp.x},${pp.y}`));
        const shuffled = [...placementsAll].sort(() => Math.random() - 0.5);

        let movedAny = false;
        let worldAfterMove: World | null = null;

        for (let k = 0; k < Math.min(MAX_MOVES_PER_TICK, shuffled.length); k++) {
          const p = shuffled[k];
          const agentId = p.agent_id;
          const x = p.x;
          const y = p.y;

          const currentActivity = scheduleFor(agentId, hh).activity;
          let intent = roamIntentByAgentRef.current.get(agentId) || null;

          // If schedule activity changed, force replan.
          if (intent && intent.activity !== currentActivity) {
            roamIntentByAgentRef.current.delete(agentId);
            intent = null;
          }

          // If already arrived, dwell until schedule changes.
          if (intent?.arrived) {
            continue;
          }

          if (!intent) {
            const created = await buildNewIntent(agentId, x, y);
            if (created) {
              roamIntentByAgentRef.current.set(agentId, created);
              intent = created;
            }
          }
          if (!intent) continue;

          // Mark arrival if already at destination.
          if (x === intent.target.x && y === intent.target.y) {
            roamIntentByAgentRef.current.set(agentId, { ...intent, arrived: true });
            continue;
          }

          // Advance pathIndex if it points at current position.
          while (
            intent.pathIndex < intent.path.length &&
            intent.path[intent.pathIndex].x === x &&
            intent.path[intent.pathIndex].y === y
          ) {
            intent.pathIndex++;
          }

          const nextPt = intent.path[intent.pathIndex];
          if (!nextPt) {
            roamIntentByAgentRef.current.set(agentId, { ...intent, arrived: true });
            continue;
          }
          if (occ.has(`${nextPt.x},${nextPt.y}`)) continue;

          try {
            worldAfterMove = await moveAgentInWorld(w.id, agentId, nextPt.x, nextPt.y);
            movedAny = true;

            // Update occupancy for subsequent moves in this tick.
            occ.delete(`${x},${y}`);
            occ.add(`${nextPt.x},${nextPt.y}`);

            roamIntentByAgentRef.current.set(agentId, { ...intent, arrived: false });

            if (worldAfterMove) {
              placementsAll = (worldAfterMove.agent_placements || []) as any[];
            }
          } catch {
            roamIntentByAgentRef.current.delete(agentId);
          }
        }

        // Refresh viewport after successful move; otherwise keep using current view.
        let v2: WorldViewResponse = v;
        if (movedAny) {
          try {
            if (worldAfterMove) setWorld(worldAfterMove);
            v2 = await getWorldView(w.id, v.x, v.y, v.width, v.height);
            setView(v2);
          } catch {
            return;
          }
        }

        // Detect adjacency (Manhattan distance 1) and request a short dialogue.
        const ps = v2.agent_placements || [];
        const MAX_CONCURRENT_ENCOUNTERS = 4;

        const labelAt = (xAbs: number, yAbs: number): WorldColorLabel | null => {
          const lx = xAbs - v2.x;
          const ly = yAbs - v2.y;
          if (lx < 0 || ly < 0 || lx >= v2.width || ly >= v2.height) return null;
          return (v2.colors?.[ly]?.[lx] as any) || null;
        };

        const placeHintForLabel = (lbl: WorldColorLabel | null): string => {
          if (!lbl || lbl === 'none') return '道路/空地';
          if (lbl === 'warning') return '食堂/餐饮区';
          if (lbl === 'error') return '寝室/住处附近';
          if (lbl === 'info') return '教学楼/课堂附近';
          if (lbl === 'primary') return '图书馆/办公室附近';
          if (lbl === 'success') return '操场/运动区';
          if (lbl === 'neutral') return '道路/广场';
          return '校园里';
        };
        for (let i = 0; i < ps.length; i++) {
          for (let j = i + 1; j < ps.length; j++) {
            const a = ps[i];
            const b = ps[j];
            const dist = Math.abs(a.x - b.x) + Math.abs(a.y - b.y);
            if (dist !== 1) continue;

            const key = [a.agent_id, b.agent_id].sort().join('|');
            const nextAllowed = encounterCooldownRef.current.get(key) || 0;
            const t = Date.now();
            if (t < nextAllowed) continue;

            if (encounterInFlightRef.current.has(key)) continue;
            if (encounterInFlightRef.current.size >= MAX_CONCURRENT_ENCOUNTERS) return;

            encounterCooldownRef.current.set(key, t + 8000);
            encounterInFlightRef.current.add(key);

            const aIntent = roamIntentByAgentRef.current.get(a.agent_id);
            const bIntent = roamIntentByAgentRef.current.get(b.agent_id);
            const aIdentity = getIdentityFor(a.agent_id);
            const bIdentity = getIdentityFor(b.agent_id);
            const aRole = aIdentity?.name || (getFallbackKind(a.agent_id) === 'teacher' ? '老师' : '学生');
            const bRole = bIdentity?.name || (getFallbackKind(b.agent_id) === 'teacher' ? '老师' : '学生');
            const aPoi = findPOIAt(a.x, a.y);
            const bPoi = findPOIAt(b.x, b.y);
            const place = (() => {
              if (aPoi) return `${aPoi.name}（${kindCn(aPoi.kind)}）`;
              if (bPoi) return `${bPoi.name}（${kindCn(bPoi.kind)}）`;
              return placeHintForLabel(labelAt(a.x, a.y) || labelAt(b.x, b.y));
            })();
            const inClassroom = (aPoi?.kind === 'classroom') || (bPoi?.kind === 'classroom');
            const inCafeteria = (aPoi?.kind === 'cafeteria') || (bPoi?.kind === 'cafeteria');
            const aKind = (aIdentity?.kind as any) || null;
            const bKind = (bIdentity?.kind as any) || null;
            const hasTeacher = aKind === 'teacher' || bKind === 'teacher';

            let topic = `现在是${timeText}，在${place}偶遇。A身份=${aRole}，正在“${aIntent?.activity || '随意走走'}”；B身份=${bRole}，正在“${bIntent?.activity || '随意走走'}”。请用自然口语简短交流，内容要强烈呼应地点/身份/活动（例如教室谈课程与作业、食堂聊饭菜与排队、图书馆聊自习与项目、办公室聊答疑等），2轮内结束。`;
            let maxTurns = 2;

            // Strongly themed encounters
            if (inClassroom) {
              const room = (aPoi?.kind === 'classroom' ? aPoi : bPoi);
              const roomName = room ? `${room.name}（${kindCn(room.kind)}）` : '教室';
              if (hasTeacher) {
                topic = `现在是${timeText}，你们在${roomName}里上课，A=${aRole}，B=${bRole}。请强制进行“课堂互动”：老师点名、提问、讲解要点、布置作业；学生回答并追问一个细节。用简短口语，允许带少量课堂口吻（如“同学们注意”“这题怎么想”）。3轮内结束。`;
                maxTurns = 3;
              } else {
                topic = `现在是${timeText}，你们在${roomName}里上课。请强制进行“课堂互动”：围绕课程内容互相提问/核对笔记/讨论作业要点，最后约定下课后去哪里（例如图书馆/食堂）。用简短口语，3轮内结束。`;
                maxTurns = 3;
              }
            } else if (inCafeteria) {
              const cafe = (aPoi?.kind === 'cafeteria' ? aPoi : bPoi);
              const cafeName = cafe ? `${cafe.name}（${kindCn(cafe.kind)}）` : '食堂';
              topic = `现在是${timeText}，你们在${cafeName}排队打饭/找座位。请强制进行“食堂吐槽/闲聊”：队伍长不长、今天菜怎么样、价格/份量、想吃什么、顺带聊一下接下来上课/作业/午休安排。用简短口语，3轮内结束。`;
              maxTurns = 3;
            }

            worldEncounterDialogue(w.id, {
              agent_a_id: a.agent_id,
              agent_b_id: b.agent_id,
              topic,
              max_turns: maxTurns,
            })
              .then(res => {
                const expiresAt = Date.now() + 5000;
                setBubbleByAgent(prev => {
                  const next = { ...prev };
                  (res.turns || []).forEach(turn => {
                    next[turn.agent_id] = { text: turn.text, expiresAt };
                  });
                  return next;
                });
              })
              .catch(() => {
                // ignore dialogue errors
              })
              .finally(() => {
                encounterInFlightRef.current.delete(key);
              });

            return;
          }
        }
      } finally {
        roamTickInFlightRef.current = false;
      }
    };

    roamTickRef.current = window.setInterval(() => {
      tick();
    }, 900);

    return () => {
      if (roamTickRef.current) {
        window.clearInterval(roamTickRef.current);
        roamTickRef.current = null;
      }
    };
  }, [autoRoam]);

