          } else {
            reds.push({ x, y });
          }
        }
      }

      const ops: any[] = [
        // Clear colors in the viewport first
        { layer: 'color', shape: 'rect', x: view.x, y: view.y, x2: view.x + view.width - 1, y2: view.y + view.height - 1, color: 'none' },
      ];
      if (blues.length) ops.push({ layer: 'color', shape: 'cells', cells: blues, color: 'primary' }); // blue-ish
      if (reds.length) ops.push({ layer: 'color', shape: 'cells', cells: reds, color: 'error' }); // red-ish

      const nextView = await drawWorld(world.id, { ops, view_x: view.x, view_y: view.y, view_w: view.width, view_h: view.height });
      setView(nextView);
      message.success(`Randomized: blue=${blues.length}, red=${reds.length}`);
    } catch (e: any) {
      message.error(e?.response?.data?.detail || e?.message || 'Randomize failed');
    } finally {
      setCreating(false);
    }
  };

