@router.get("/worlds", response_model=List[WorldResponse])


async def list_worlds(current_user: User = Depends(get_current_user)):


    out = []


    changed = False


    for w in WORLDS_DB.values():


        if w.get("user_id") != current_user.username:


            continue


        _normalize_world_schema(w)


        changed = changed or ("grid" not in w)


        out.append(


            WorldResponse(


                id=w.get("id"),


                name=w.get("name"),


                width=w.get("width"),


                height=w.get("height"),


                walls_count=len(w.get("walls") or []),


                colors_count=len(w.get("colors") or {}),


                agent_placements=w.get("agent_placements") or [],


                pois=w.get("pois") or [],


                identities=w.get("identities") or [],


                agent_identities=w.get("agent_identities") or {},


            )


        )


    if changed:


        save_data("worlds.json", WORLDS_DB)


    return out








def _poi_area_seed_cells(poi: Dict, max_cells: int = 5000) -> List[tuple[int, int]]:


    """Return seed cells belonging to a POI area (bounded)."""


    shape = (poi.get("shape") or "point")


    if shape == "rect":


        x0 = int(poi.get("x") or 0)


        y0 = int(poi.get("y") or 0)


        w = int(poi.get("w") or 0)


        h = int(poi.get("h") or 0)


        if w <= 0 or h <= 0:


            return [(x0, y0)]


        # Prefer perimeter + a few interior samples (keeps it fast).


        out: List[tuple[int, int]] = []


        for xx in range(x0, x0 + w):


            out.append((xx, y0))


            out.append((xx, y0 + h - 1))


        for yy in range(y0, y0 + h):


            out.append((x0, yy))


            out.append((x0 + w - 1, yy))


        # center


        out.append((x0 + w // 2, y0 + h // 2))


        # dedupe + cap


        seen = set()


        uniq: List[tuple[int, int]] = []


        for p in out:


            if p in seen:


                continue


            seen.add(p)


            uniq.append(p)


            if len(uniq) >= max_cells:


                break


        return uniq





    if shape == "cells":


        cells = poi.get("cells") or []


        out: List[tuple[int, int]] = []


        for c in cells:


            try:


                out.append((int(c.get("x") or 0), int(c.get("y") or 0)))


            except Exception:


                continue


            if len(out) >= max_cells:


                break


        if out:


            return out





    # point


    return [(int(poi.get("x") or 0), int(poi.get("y") or 0))]








