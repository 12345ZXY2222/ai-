@router.post("/agents/{agent_id}/upload")


async def upload_agent_file(agent_id: str, file: UploadFile = File(...), current_user: User = Depends(get_current_user)):


    agent = AGENTS_DB.get(agent_id)


    if not agent or agent.get("user_id") != current_user.username:


        raise HTTPException(status_code=404, detail="Agent not found")





    upload_dir = f"uploads/{agent_id}"


    os.makedirs(upload_dir, exist_ok=True)





    file_path = f"{upload_dir}/{file.filename}"


    with open(file_path, "wb") as buffer:


        shutil.copyfileobj(file.file, buffer)





    if 'files' not in agent:


        agent['files'] = []





    if file.filename not in agent['files']:


        agent['files'].append(file.filename)


        save_data("agents.json", AGENTS_DB)





    return {"filename": file.filename, "message": "File uploaded successfully"}





@router.get("/agents/{agent_id}", response_model=AgentResponse)


async def get_agent(agent_id: str, current_user: User = Depends(get_current_user)):


    agent = AGENTS_DB.get(agent_id)


    if not agent or agent.get("user_id") != current_user.username:


        raise HTTPException(status_code=404, detail="Agent not found")





    relationships_desc = []


    for rel in RELATIONSHIPS_DB.values():


        # Only show relationships if both agents belong to user (or at least the one being queried)


        # For simplicity, we assume relationships are also owned by user


        if rel.get("user_id") == current_user.username:


            if rel['source_agent_id'] == agent_id:


                target = AGENTS_DB.get(rel['target_agent_id'])


                if target:


                    relationships_desc.append(f"You are {rel['relationship_type']} of {target['name']}")


            elif rel['target_agent_id'] == agent_id:


                source = AGENTS_DB.get(rel['source_agent_id'])


                if source:


                    relationships_desc.append(f"{source['name']} is {rel['relationship_type']} of you")





    if 'files' not in agent:


        agent['files'] = []





    return AgentResponse(**agent, relationships=relationships_desc)





@router.put("/agents/{agent_id}", response_model=AgentResponse)


async def update_agent(agent_id: str, agent_update: AgentUpdateRequest, current_user: User = Depends(get_current_user)):


    agent = AGENTS_DB.get(agent_id)


    if not agent or agent.get("user_id") != current_user.username:


        raise HTTPException(status_code=404, detail="Agent not found")





    updated_data = agent_update.dict(exclude_unset=True)


    agent.update(updated_data)





    AGENTS_DB[agent_id] = agent


    save_data("agents.json", AGENTS_DB)


    return AgentResponse(**agent)





class MemoryInjectRequest(BaseModel):


    content: str


    importance: int = 1





@router.post("/agents/{agent_id}/memory/inject")


async def inject_memory(agent_id: str, req: MemoryInjectRequest, current_user: User = Depends(get_current_user)):


    agent = AGENTS_DB.get(agent_id)


    if not agent or agent.get("user_id") != current_user.username:


        raise HTTPException(status_code=404, detail="Agent not found")





    try:


        # 1. Update Complex Memory


        mem_agent = MemoryAgent(agent_id)


        result = mem_agent.add_observation(req.content, req.importance)





        # 2. Update Simple Memory (for immediate visibility in {{memory}})


        if 'long_term_memory' not in agent:


            agent['long_term_memory'] = []


        agent['long_term_memory'].append(req.content)


        save_data("agents.json", AGENTS_DB)





        return {"status": "success", "message": result}


    except Exception as e:


        raise HTTPException(status_code=500, detail=str(e))





@router.delete("/agents/{agent_id}")


async def delete_agent(agent_id: str, current_user: User = Depends(get_current_user)):


    agent = AGENTS_DB.get(agent_id)


    if not agent or agent.get("user_id") != current_user.username:


        raise HTTPException(status_code=404, detail="Agent not found")





    del AGENTS_DB[agent_id]


    save_data("agents.json", AGENTS_DB)





    to_delete = []


    for rel_id, rel in RELATIONSHIPS_DB.items():


        if rel.get("user_id") == current_user.username:


            if rel['source_agent_id'] == agent_id or rel['target_agent_id'] == agent_id:


                to_delete.append(rel_id)


    for rid in to_delete:


        del RELATIONSHIPS_DB[rid]


    save_data("relationships.json", RELATIONSHIPS_DB)


    return {"message": "Agent deleted"}





@router.post("/agents/{agent_id}/duplicate", response_model=AgentResponse)


async def duplicate_agent(agent_id: str, current_user: User = Depends(get_current_user)):


    agent = AGENTS_DB.get(agent_id)


    if not agent or agent.get("user_id") != current_user.username:


        raise HTTPException(status_code=404, detail="Agent not found")





    new_agent_id = str(uuid.uuid4())


    new_agent = agent.copy()


    new_agent['id'] = new_agent_id


    new_agent['name'] = f"Copy of {agent['name']}"


    # Ensure user_id is set (though it should be in copy)


    new_agent['user_id'] = current_user.username





    if 'files' in agent and agent['files']:


        original_dir = f"uploads/{agent_id}"


        new_dir = f"uploads/{new_agent_id}"


        if os.path.exists(original_dir):


            os.makedirs(new_dir, exist_ok=True)


            for filename in agent['files']:


                src = os.path.join(original_dir, filename)


                dst = os.path.join(new_dir, filename)


                if os.path.exists(src):


                    shutil.copy2(src, dst)





    AGENTS_DB[new_agent_id] = new_agent


    save_data("agents.json", AGENTS_DB)


    return AgentResponse(**new_agent)





@router.put("/agents/{agent_id}/memory", response_model=Dict)


async def update_agent_memory(agent_id: str, memory: List[str], current_user: User = Depends(get_current_user)):


    agent = AGENTS_DB.get(agent_id)


    if not agent or agent.get("user_id") != current_user.username:


        raise HTTPException(status_code=404, detail="Agent not found")


    agent['long_term_memory'] = memory


    save_data("agents.json", AGENTS_DB)


    return {"message": "Memory updated"}








