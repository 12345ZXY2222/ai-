@router.post("/worlds/{world_id}/pois", response_model=WorldPOI)


async def create_world_poi(world_id: str, req: WorldPOICreateRequest, current_user: User = Depends(get_current_user)):


    world = WORLDS_DB.get(world_id)


    if not world or world.get("user_id") != current_user.username:


        raise HTTPException(status_code=404, detail="World not found")


    _normalize_world_schema(world)





    width, height = int(world.get("width") or 0), int(world.get("height") or 0)


    if not (0 <= req.x < width and 0 <= req.y < height):


        raise HTTPException(status_code=400, detail="POI position out of bounds")





    poi = WorldPOI(


        id=str(uuid.uuid4()),


        name=req.name,


        kind=req.kind,


        label=req.label,


        x=req.x,


        y=req.y,


        description=req.description,


    )





    pois = world.get("pois") or []


    pois.append(poi.dict())


    world["pois"] = pois


    WORLDS_DB[world_id] = world


    save_data("worlds.json", WORLDS_DB)





    _append_world_event(


        current_user,


        world,


        "create_poi",


        {"poi_id": poi.id, "name": poi.name, "kind": poi.kind, "label": poi.label, "x": poi.x, "y": poi.y},


    )


    return poi








@router.put("/worlds/{world_id}/pois/{poi_id}", response_model=WorldPOI)


async def update_world_poi(world_id: str, poi_id: str, req: WorldPOIUpdateRequest, current_user: User = Depends(get_current_user)):


    world = WORLDS_DB.get(world_id)


    if not world or world.get("user_id") != current_user.username:


        raise HTTPException(status_code=404, detail="World not found")


    _normalize_world_schema(world)





    width, height = int(world.get("width") or 0), int(world.get("height") or 0)


    pois = world.get("pois") or []


    found = None


    for p in pois:


        if p.get("id") == poi_id:


            found = p


            break


    if not found:


        raise HTTPException(status_code=404, detail="POI not found")





    if req.name is not None:


        found["name"] = req.name


    if req.kind is not None:


        found["kind"] = req.kind


    if req.label is not None:


        found["label"] = req.label


    if req.description is not None:


        found["description"] = req.description


    if req.x is not None:


        if not (0 <= req.x < width):


            raise HTTPException(status_code=400, detail="POI x out of bounds")


        found["x"] = req.x


    if req.y is not None:


        if not (0 <= req.y < height):


            raise HTTPException(status_code=400, detail="POI y out of bounds")


        found["y"] = req.y





    world["pois"] = pois


    WORLDS_DB[world_id] = world


    save_data("worlds.json", WORLDS_DB)





    _append_world_event(current_user, world, "update_poi", {"poi_id": poi_id})


    return WorldPOI(**found)








@router.delete("/worlds/{world_id}/pois/{poi_id}")


async def delete_world_poi(world_id: str, poi_id: str, current_user: User = Depends(get_current_user)):


    world = WORLDS_DB.get(world_id)


    if not world or world.get("user_id") != current_user.username:


        raise HTTPException(status_code=404, detail="World not found")


    _normalize_world_schema(world)





    pois = world.get("pois") or []


    new_pois = [p for p in pois if p.get("id") != poi_id]


    if len(new_pois) == len(pois):


        raise HTTPException(status_code=404, detail="POI not found")





    world["pois"] = new_pois


    WORLDS_DB[world_id] = world


    save_data("worlds.json", WORLDS_DB)





    _append_world_event(current_user, world, "delete_poi", {"poi_id": poi_id})


    return {"message": "POI deleted"}








@router.post("/worlds/{world_id}/plan_path_to_poi", response_model=PlanPathToPOIResponse)


async def plan_path_to_poi(world_id: str, req: PlanPathToPOIRequest, current_user: User = Depends(get_current_user)):


    """Plan a path from an agent to a named POI's anchor (or nearby walkable cell)."""


    world = WORLDS_DB.get(world_id)


    if not world or world.get("user_id") != current_user.username:


        raise HTTPException(status_code=404, detail="World not found")





    _normalize_world_schema(world)





    placements = world.get("agent_placements") or []


    start = None


    for p in placements:


        if p.get("agent_id") == req.agent_id:


            start = (int(p.get("x") or 0), int(p.get("y") or 0))


            break


    if start is None:


        raise HTTPException(status_code=404, detail="Agent not placed in world")





    poi_raw = None


    for p in (world.get("pois") or []):


        if p.get("id") == req.poi_id:


            poi_raw = p


            break


    if not poi_raw:


        raise HTTPException(status_code=404, detail="POI not found")





    poi = WorldPOI(**poi_raw)


    seeds = _poi_area_seed_cells(poi_raw, max_cells=5000)


    sx, sy = start





    # Prefer POI seeds nearer to the agent; keep it bounded for performance.


    if seeds:


        seeds.sort(key=lambda t: abs(t[0] - sx) + abs(t[1] - sy))


        seeds = seeds[:200]





    # Expand seeds to nearby walkable target candidates; try nearest first.


    cand: List[tuple[int, int]] = []


    seen = set()


    for (px, py) in seeds:


        for (tx, ty) in _nearby_candidates(world, int(px), int(py), int(req.max_radius)):


            if (tx, ty) in seen:


                continue


            seen.add((tx, ty))


            cand.append((tx, ty))


            if len(cand) >= 220:


                break


        if len(cand) >= 220:


            break





    if not cand:


        raise HTTPException(status_code=400, detail="No reachable target near POI area")





    cand.sort(key=lambda t: abs(t[0] - sx) + abs(t[1] - sy))


    max_attempts = 40


    for (tx, ty) in cand[:max_attempts]:


        path = _a_star_path(world, sx, sy, tx, ty)


        if not path:


            continue


        return PlanPathToPOIResponse(


            poi=poi,


            target=PathPoint(x=tx, y=ty),


            path=[PathPoint(x=x, y=y) for (x, y) in path],


        )





    raise HTTPException(status_code=400, detail="No path found to POI")








@router.get("/worlds/{world_id}/identities", response_model=WorldIdentitiesResponse)


async def list_world_identities(world_id: str, current_user: User = Depends(get_current_user)):


    world = WORLDS_DB.get(world_id)


    if not world or world.get("user_id") != current_user.username:


        raise HTTPException(status_code=404, detail="World not found")


