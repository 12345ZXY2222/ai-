@router.post("/worlds/{world_id}/agents/place", response_model=WorldResponse)


async def place_agent_in_world(world_id: str, req: PlaceAgentRequest, current_user: User = Depends(get_current_user)):


    world = WORLDS_DB.get(world_id)


    if not world or world.get("user_id") != current_user.username:


        raise HTTPException(status_code=404, detail="World not found")





    _normalize_world_schema(world)


    width, height = world.get("width"), world.get("height")


    if not (0 <= req.x < width and 0 <= req.y < height):


        raise HTTPException(status_code=400, detail="Position out of bounds")


    if _cell_blocked(world, req.x, req.y):


        raise HTTPException(status_code=400, detail="Cell is blocked")





    placements = world.get("agent_placements") or []


    placements = [p for p in placements if p.get("agent_id") != req.agent_id]


    placements.append({"agent_id": req.agent_id, "x": req.x, "y": req.y})


    world["agent_placements"] = placements


    WORLDS_DB[world_id] = world


    save_data("worlds.json", WORLDS_DB)





    _append_world_event(


        current_user,


        world,


        "place_agent",


        {"agent_id": req.agent_id, "x": req.x, "y": req.y},


    )


    return WorldResponse(


        id=world.get("id"),


        name=world.get("name"),


        width=world.get("width"),


        height=world.get("height"),


        walls_count=len(world.get("walls") or []),


        colors_count=len(world.get("colors") or {}),


        agent_placements=world.get("agent_placements") or [],


        pois=world.get("pois") or [],


        identities=world.get("identities") or [],


        agent_identities=world.get("agent_identities") or {},


    )








@router.post("/worlds/{world_id}/agents/move", response_model=WorldResponse)


async def move_agent_in_world(world_id: str, req: MoveAgentRequest, current_user: User = Depends(get_current_user)):


    world = WORLDS_DB.get(world_id)


    if not world or world.get("user_id") != current_user.username:


        raise HTTPException(status_code=404, detail="World not found")





    _normalize_world_schema(world)


    width, height = world.get("width"), world.get("height")


    if not (0 <= req.to_x < width and 0 <= req.to_y < height):


        raise HTTPException(status_code=400, detail="Target out of bounds")


    if _cell_blocked(world, req.to_x, req.to_y):


        raise HTTPException(status_code=400, detail="Target cell is blocked")





    placements = world.get("agent_placements") or []


    found = False


    for p in placements:


        if p.get("agent_id") == req.agent_id:


            p["x"], p["y"] = req.to_x, req.to_y


            found = True


            break


    if not found:


        raise HTTPException(status_code=404, detail="Agent not placed in world")





    world["agent_placements"] = placements


    WORLDS_DB[world_id] = world


    save_data("worlds.json", WORLDS_DB)





    _append_world_event(


        current_user,


        world,


        "move_agent",


        {"agent_id": req.agent_id, "to_x": req.to_x, "to_y": req.to_y},


    )


    return WorldResponse(


        id=world.get("id"),


        name=world.get("name"),


        width=world.get("width"),


        height=world.get("height"),


        walls_count=len(world.get("walls") or []),


        colors_count=len(world.get("colors") or {}),


        agent_placements=world.get("agent_placements") or [],


        pois=world.get("pois") or [],


        identities=world.get("identities") or [],


        agent_identities=world.get("agent_identities") or {},


    )








@router.post("/worlds/{world_id}/plan_path", response_model=PlanPathResponse)


async def plan_path(world_id: str, req: PlanPathRequest, current_user: User = Depends(get_current_user)):


    world = WORLDS_DB.get(world_id)


    if not world or world.get("user_id") != current_user.username:


        raise HTTPException(status_code=404, detail="World not found")





    _normalize_world_schema(world)





    placements = world.get("agent_placements") or []


    start = None


    for p in placements:


        if p.get("agent_id") == req.agent_id:


            start = (p.get("x"), p.get("y"))


            break


    if start is None:


        raise HTTPException(status_code=404, detail="Agent not placed in world")





    path = _cached_a_star_path(world_id, world, start[0], start[1], req.target_x, req.target_y)


    if not path:


        raise HTTPException(status_code=400, detail="No path found")


    return PlanPathResponse(path=[PathPoint(x=x, y=y) for (x, y) in path])








