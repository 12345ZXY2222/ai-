@router.post("/worlds", response_model=WorldResponse)


async def create_world(req: WorldCreateRequest, current_user: User = Depends(get_current_user)):


    world_id = str(uuid.uuid4())


    walls, colors = make_preset_layers(req.width, req.height, req.preset)





    identities = []


    if req.preset == "campus":


        identities = [


            {


                "id": "student",


                "name": "学生",


                "kind": "student",


                "description": "在校园里上课、自习、运动、回寝室",


                "schedule": [


