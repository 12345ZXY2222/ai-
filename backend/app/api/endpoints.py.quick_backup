# ---------- Path Planning Cache ----------

import hashlib

from functools import lru_cache

from typing import Dict, Tuple, Optional



# In-memory cache for path planning results

_path_cache: Dict[Tuple[str, int, int, int, int], list] = {}

_world_version: Dict[str, int] = {}



def _get_world_version(world_id: str) -> int:

    """Get current version number for a world, incrementing if not exists."""

    if world_id not in _world_version:

        _world_version[world_id] = 0

    return _world_version[world_id]



def _invalidate_world_cache(world_id: str):

    """Invalidate all cached paths for a world."""

    keys_to_delete = [key for key in _path_cache.keys() if key[0] == world_id]

    for key in keys_to_delete:

        del _path_cache[key]

    _world_version[world_id] = _world_version.get(world_id, 0) + 1

    print(f"Invalidated cache for world {world_id}, new version {_world_version[world_id]}")



def _cached_a_star_path(world_id: str, world: dict, start_x: int, start_y: int, target_x: int, target_y: int) -> Optional[list]:

    """Cached version of _a_star_path."""

    version = _get_world_version(world_id)

    cache_key = (world_id, start_x, start_y, target_x, target_y)

    if cache_key in _path_cache:

        return _path_cache[cache_key]

    # Compute path

    path = _a_star_path(world, start_x, start_y, target_x, target_y)

    if path is not None:

        _path_cache[cache_key] = path

    return path

# ---------- End Cache ----------



def _append_world_event(current_user: User, world: Dict, event_type: str, data: Dict) -> None:


    """Append a per-world event record to backend/data/world_events.json (best-effort)."""


    try:


        world_id = world.get("id")


        if not world_id:


            return


        if world.get("user_id") != current_user.username:


            return





        ev = {


            "id": str(uuid.uuid4()),


            "world_id": world_id,


            "type": event_type,


            "timestamp": time.time(),


            "data": data or {},


        }


        WORLD_EVENTS_DB.setdefault(world_id, []).append(ev)


        if len(WORLD_EVENTS_DB[world_id]) > 1000:


            WORLD_EVENTS_DB[world_id] = WORLD_EVENTS_DB[world_id][-1000:]


        save_data("world_events.json", WORLD_EVENTS_DB)


    except Exception:


        return








def _append_agent_chat_history(agent_id: str, message: Dict) -> None:


    if not agent_id:


        return


    CHAT_HISTORY_DB.setdefault(agent_id, []).append(message)


    if len(CHAT_HISTORY_DB[agent_id]) > 5000:


        CHAT_HISTORY_DB[agent_id] = CHAT_HISTORY_DB[agent_id][-5000:]


    save_data("chat_history.json", CHAT_HISTORY_DB)








def _inject_agent_memory_side_effect(agent: Dict, content: str, importance: int = 1) -> None:


    """Best-effort memory injection mirroring /agents/{id}/memory/inject."""


    try:


        agent_id = agent.get("id")


        if not agent_id or not content:


            return


        mem_agent = MemoryAgent(agent_id)


        mem_agent.add_observation(content, importance)





        if "long_term_memory" not in agent:


            agent["long_term_memory"] = []


        agent["long_term_memory"].append(content)


        AGENTS_DB[agent_id] = agent


        save_data("agents.json", AGENTS_DB)


    except Exception:


        return








def _coord_key(x: int, y: int) -> str:


    return f"{x},{y}"








def _parse_coord_key(key: str):


    xs, ys = key.split(",", 1)


    return int(xs), int(ys)








def _normalize_world_schema(world: Dict) -> Dict:


    """Migrate legacy dense `grid` worlds into sparse `walls` + `colors` fields."""


    if world is None:


        return world





    width = int(world.get("width") or 0)


    height = int(world.get("height") or 0)


    world.setdefault("agent_placements", [])


    world.setdefault("pois", [])


    world.setdefault("identities", [])


    world.setdefault("agent_identities", {})





    if "walls" not in world or "colors" not in world:


        walls = set()


        colors: Dict[str, WorldColorLabel] = {}


        grid = world.get("grid")


        if isinstance(grid, list) and grid:


            # Best-effort migration.


            for y, row in enumerate(grid):


                if not isinstance(row, list):


                    continue


                for x, cell in enumerate(row):


                    if cell == "wall":


                        walls.add(_coord_key(x, y))


                    elif cell == "court":


                        colors[_coord_key(x, y)] = "neutral"


        world["walls"] = sorted(walls)


        world["colors"] = colors


        # Avoid persisting huge dense grids.


        if "grid" in world:


            del world["grid"]





    # Ensure types


    if not isinstance(world.get("walls"), list):


        world["walls"] = []


    if not isinstance(world.get("colors"), dict):


        world["colors"] = {}


    if not isinstance(world.get("pois"), list):


        world["pois"] = []


    if not isinstance(world.get("identities"), list):


        world["identities"] = []


    if not isinstance(world.get("agent_identities"), dict):


        world["agent_identities"] = {}





    # Clamp any out-of-bounds coords defensively


    if width > 0 and height > 0:


        wset = set()


        for k in world.get("walls") or []:


            try:


                x, y = _parse_coord_key(k)


            except Exception:


                continue


            if 0 <= x < width and 0 <= y < height:


                wset.add(_coord_key(x, y))


        world["walls"] = sorted(wset)





        colors2: Dict[str, WorldColorLabel] = {}


        for k, v in (world.get("colors") or {}).items():


            try:


                x, y = _parse_coord_key(k)


            except Exception:


                continue


            if 0 <= x < width and 0 <= y < height:


                colors2[_coord_key(x, y)] = v


        world["colors"] = colors2





    # Sanitize identity schedules (older data may contain unsupported poi kinds, e.g. 'plaza')


    allowed_poi_kinds = {"custom", "cafeteria", "dorm", "classroom", "library", "office", "sports"}


    kind_aliases = {


        "plaza": "custom",


    }


    identities = world.get("identities") or []


    if isinstance(identities, list):


        for ident in identities:


            if not isinstance(ident, dict):


                continue


            schedule = ident.get("schedule")


            if schedule is None:


                continue


            if not isinstance(schedule, list):


                ident["schedule"] = []


                continue


            for entry in schedule:


                if not isinstance(entry, dict):


                    continue


                kinds = entry.get("poi_kinds")


                if kinds is None:


                    continue


                if not isinstance(kinds, list):


                    entry["poi_kinds"] = []


                    continue


                cleaned: List[str] = []


                for k in kinds:


                    if not isinstance(k, str):


                        continue


                    kk = kind_aliases.get(k, k)


                    if kk in allowed_poi_kinds:


                        cleaned.append(kk)


                entry["poi_kinds"] = cleaned





    return world








def _world_walls_set(world: Dict) -> set:


    return set((_normalize_world_schema(world).get("walls") or []))








def _cell_blocked(world: Dict, x: int, y: int) -> bool:


    return _coord_key(x, y) in _world_walls_set(world)








def _nearby_candidates(world: Dict, x: int, y: int, max_radius: int) -> List[tuple[int, int]]:


    """Return candidate unblocked cells around (x,y), ordered by increasing Manhattan distance.





    Used to find a walkable target near a POI seed when the seed lies on/near walls.


    """


    world = _normalize_world_schema(world)


    width = int(world.get("width") or 0)


    height = int(world.get("height") or 0)


    rmax = max(0, min(int(max_radius or 0), 50))





    out: List[tuple[int, int]] = []


    seen: set[tuple[int, int]] = set()





    def add(xx: int, yy: int):


        if not (0 <= xx < width and 0 <= yy < height):


            return


        k = (xx, yy)


        if k in seen:


            return


        seen.add(k)


        if _cell_blocked(world, xx, yy):


            return


        out.append((xx, yy))





    add(int(x), int(y))


    for r in range(1, rmax + 1):


        for dx in range(-r, r + 1):


            dy = r - abs(dx)


            add(x + dx, y + dy)


            if dy != 0:


                add(x + dx, y - dy)





    return out








def _world_ascii(world: Dict) -> str:


    world = _normalize_world_schema(world)


    width = int(world.get("width") or 0)


    height = int(world.get("height") or 0)


    walls = _world_walls_set(world)


    colors = world.get("colors") or {}


    placements = {p.get('agent_id'): (p.get('x'), p.get('y')) for p in (world.get('agent_placements') or [])}


    inv = {}


    for aid, (x, y) in placements.items():


        inv[(x, y)] = (aid[:2] if aid else 'A')





    # Safety: never dump huge maps; show a top-left window.


    max_w = min(80, width)


    max_h = min(40, height)


    ox, oy = 0, 0





    lines = [f"World view ({ox},{oy}) size {max_w}x{max_h} of {width}x{height}"]


    for y in range(oy, oy + max_h):


        parts = []


        for x in range(ox, ox + max_w):


            if (x, y) in inv:


                parts.append(inv[(x, y)])


            elif _coord_key(x, y) in walls:


                parts.append('##')


            elif colors.get(_coord_key(x, y)) and colors.get(_coord_key(x, y)) != 'none':


                parts.append('..')


            else:


                parts.append('  ')


        lines.append(''.join(parts))


    return "\n".join(lines)








def _validate_grid(grid, width: int, height: int):


    # Legacy validation.


    if not isinstance(grid, list) or len(grid) != height:


        raise HTTPException(status_code=400, detail="Invalid grid height")


    for row in grid:


        if not isinstance(row, list) or len(row) != width:


            raise HTTPException(status_code=400, detail="Invalid grid width")








def _bresenham_line(x0: int, y0: int, x1: int, y1: int):


    points = []


    dx = abs(x1 - x0)


    dy = -abs(y1 - y0)


    sx = 1 if x0 < x1 else -1


    sy = 1 if y0 < y1 else -1


    err = dx + dy


    x, y = x0, y0


    while True:


        points.append((x, y))


        if x == x1 and y == y1:


            break


        e2 = 2 * err


        if e2 >= dy:


            err += dy


            x += sx


        if e2 <= dx:


            err += dx


            y += sy


    return points








def _apply_draw_ops(world: Dict, ops: List[WorldDrawOp]):


    world = _normalize_world_schema(world)


    width = int(world.get("width") or 0)


    height = int(world.get("height") or 0)


    walls = set(world.get("walls") or [])


    colors: Dict[str, WorldColorLabel] = dict(world.get("colors") or {})





    def in_bounds(x: int, y: int) -> bool:


        return 0 <= x < width and 0 <= y < height





    def iter_points(op: WorldDrawOp):


        if op.shape == "cell":


            if op.x is None or op.y is None:


                return []


            return [(op.x, op.y)]


        if op.shape == "cells":


            if not op.cells:


                return []


            return [(p.x, p.y) for p in op.cells]


        if op.shape == "rect":


            if op.x is None or op.y is None or op.x2 is None or op.y2 is None:


                return []


            x1, y1 = min(op.x, op.x2), min(op.y, op.y2)


            x2, y2 = max(op.x, op.x2), max(op.y, op.y2)


            pts = []


            for yy in range(y1, y2 + 1):


                for xx in range(x1, x2 + 1):


                    pts.append((xx, yy))


            return pts


        if op.shape == "line":


            if op.x is None or op.y is None or op.x2 is None or op.y2 is None:


                return []


            return _bresenham_line(op.x, op.y, op.x2, op.y2)


        return []





    for op in ops:


        pts = iter_points(op)


        if not pts:


            continue





        if op.layer == "wall":


            if op.wall is None:


                raise HTTPException(status_code=400, detail="Wall op missing 'wall' boolean")


            for (x, y) in pts:


                if not in_bounds(x, y):


                    continue


                k = _coord_key(x, y)


                if op.wall:


                    walls.add(k)


                else:


                    walls.discard(k)


        elif op.layer == "color":


            if op.color is None:


                raise HTTPException(status_code=400, detail="Color op missing 'color'")


            for (x, y) in pts:


                if not in_bounds(x, y):


                    continue


                k = _coord_key(x, y)


                if op.color == "none":


                    colors.pop(k, None)


                else:


                    colors[k] = op.color


        else:


            raise HTTPException(status_code=400, detail="Unknown draw layer")





    world["walls"] = sorted(walls)


    world["colors"] = colors


    return world








_COLOR_LABEL_RGB: Dict[WorldColorLabel, tuple[int, int, int]] = {


    # Approximate Ant Design palette (used only for nearest-color mapping).


    "none": (255, 255, 255),


    "neutral": (140, 140, 140),


    "primary": (22, 119, 255),


    "success": (82, 196, 26),


    "warning": (250, 173, 20),


    "error": (255, 77, 79),


    "info": (19, 194, 194),


}








def _parse_first_image_url(maybe_content: object) -> Optional[str]:


    """Parse a first image_url from an OpenAI-style JSON content list."""


    if not maybe_content:


        return None


    try:


        if isinstance(maybe_content, str):


            s = maybe_content.strip()


            if not (s.startswith("[") and s.endswith("]")):


                return None


            items = json.loads(s)


        elif isinstance(maybe_content, list):


            items = maybe_content


        else:


            return None





        if not isinstance(items, list):


            return None


        for item in items:


            if not isinstance(item, dict):


                continue


            if item.get("type") == "image_url":


                iu = item.get("image_url")


                if isinstance(iu, dict):


                    url = iu.get("url")


                    if isinstance(url, str) and url:


                        return url


    except Exception:


        return None


    return None








def _download_image_bytes(url: str) -> bytes:


    if url.startswith("data:"):


        # data:image/png;base64,...


        header, b64 = url.split(",", 1)


        return base64.b64decode(b64)


    resp = requests.get(url, timeout=60)


    resp.raise_for_status()


    return resp.content








def _rgb_dist2(a: tuple[int, int, int], b: tuple[int, int, int]) -> int:


    return (a[0] - b[0]) ** 2 + (a[1] - b[1]) ** 2 + (a[2] - b[2]) ** 2








def _pixel_to_label_or_wall(r: int, g: int, b: int, a: int) -> tuple[Optional[WorldColorLabel], bool]:


    # Transparent => ignore.


    if a < 128:


        return "none", False





    # Very dark => treat as wall.


    if (r + g + b) <= 90:


        return None, True





    # Very bright near-white => none.


    if (r + g + b) >= 735:


        return "none", False





    rgb = (r, g, b)


    best_label: WorldColorLabel = "neutral"


    best_d2 = 1_000_000_000


    for label, pal_rgb in _COLOR_LABEL_RGB.items():


        if label == "none":


            continue


        d2 = _rgb_dist2(rgb, pal_rgb)


        if d2 < best_d2:


            best_d2 = d2


            best_label = label


    return best_label, False








def _image_to_world_ops(img: Image.Image, view_x: int, view_y: int, view_w: int, view_h: int) -> List[WorldDrawOp]:


    rgba = img.convert("RGBA")


    # Resize to match viewport, using nearest neighbor to preserve pixel-art feel.


    rgba = rgba.resize((view_w, view_h), resample=Image.Resampling.NEAREST)





    wall_cells: List[PathPoint] = []


    color_cells: Dict[WorldColorLabel, List[PathPoint]] = {}





    px = rgba.load()


    for y_local in range(view_h):


        for x_local in range(view_w):


            r, g, b, a = px[x_local, y_local]


            label, is_wall = _pixel_to_label_or_wall(r, g, b, a)


            x_abs = view_x + x_local


            y_abs = view_y + y_local


            if is_wall:


                wall_cells.append(PathPoint(x=x_abs, y=y_abs))


            else:


                if label and label != "none":


                    color_cells.setdefault(label, []).append(PathPoint(x=x_abs, y=y_abs))





    ops: List[WorldDrawOp] = []





    # Clear viewport first (walls + colors) so image fully defines the region.


    ops.append(


        WorldDrawOp(


            layer="wall",


            shape="rect",


            x=view_x,


            y=view_y,


            x2=view_x + view_w - 1,


            y2=view_y + view_h - 1,


            wall=False,


        )


    )


    ops.append(


        WorldDrawOp(


            layer="color",


            shape="rect",


            x=view_x,


            y=view_y,


            x2=view_x + view_w - 1,


            y2=view_y + view_h - 1,


            color="none",


        )


    )





    if wall_cells:


        ops.append(WorldDrawOp(layer="wall", shape="cells", cells=wall_cells, wall=True))





    for label, pts in color_cells.items():


        if pts:


            ops.append(WorldDrawOp(layer="color", shape="cells", cells=pts, color=label))





    return ops








def _find_agent_for_image(current_user: User, agent_id: Optional[str]) -> Optional[Dict]:


    if agent_id:


        return AGENTS_DB.get(agent_id)





    # Prefer the current user's agent named AI_4.


    for a in AGENTS_DB.values():


        if a.get("user_id") == current_user.username and a.get("name") == "AI_4":


            return a


    # Fallback: any agent named AI_4.


    for a in AGENTS_DB.values():


        if a.get("name") == "AI_4":


            return a


    return None








def _invoke_custom_agent_raw(agent: Dict, prompt: str) -> Dict[str, object]:


    code_str = agent.get("usage_example")


    if not isinstance(code_str, str) or not code_str.strip():


        raise HTTPException(status_code=500, detail="Custom agent missing usage_example")





    local_scope = {"json": json}


    exec(code_str, local_scope)


    if "invoke_custom_agent" not in local_scope:


        raise HTTPException(status_code=500, detail="Custom agent code must define invoke_custom_agent")


    invoke_func = local_scope["invoke_custom_agent"]





    res = invoke_func(


        messages=[{"role": "user", "content": prompt}],


        api_key=agent.get("api_key"),


        base_url=agent.get("base_url"),


        model=agent.get("model"),


        temperature=0.7,


    )





    if isinstance(res, dict):


        return res


    return {"content": str(res), "raw": res}








def _execute_world_script(world: Dict, view: WorldViewResponse, commands: List[WorldScriptCommand], max_cells: int):


    """Execute a restricted set of drawing macros into draw ops. All effects are constrained to a region (defaults to viewport)."""


    import random





    ops: List[WorldDrawOp] = []


    total_cells_touched = 0





    def region(cmd: WorldScriptCommand):


        rx = cmd.x if cmd.x is not None else view.x


        ry = cmd.y if cmd.y is not None else view.y


        rw = cmd.w if cmd.w is not None else view.width


        rh = cmd.h if cmd.h is not None else view.height


        # clamp to viewport bounds for safety


        rx = max(view.x, min(view.x + view.width - 1, rx))


        ry = max(view.y, min(view.y + view.height - 1, ry))


        rw = max(1, min(rw, view.x + view.width - rx))


        rh = max(1, min(rh, view.y + view.height - ry))


        return rx, ry, rw, rh





    for cmd in commands:


        rx, ry, rw, rh = region(cmd)





        if cmd.type == "fill_rect":


            if cmd.color is None:


                raise HTTPException(status_code=400, detail="script.fill_rect missing color")


            ops.append(WorldDrawOp(layer="color", shape="rect", x=rx, y=ry, x2=rx + rw - 1, y2=ry + rh - 1, color=cmd.color))





        elif cmd.type == "border_walls":


            t = int(cmd.thickness or 1)


            t = max(1, min(10, t))


            wall_val = True if cmd.wall is None else bool(cmd.wall)


            # top/bottom


            for i in range(t):


                ops.append(WorldDrawOp(layer="wall", shape="rect", x=rx, y=ry + i, x2=rx + rw - 1, y2=ry + i, wall=wall_val))


                ops.append(WorldDrawOp(layer="wall", shape="rect", x=rx, y=ry + rh - 1 - i, x2=rx + rw - 1, y2=ry + rh - 1 - i, wall=wall_val))


            # left/right


            for i in range(t):


                ops.append(WorldDrawOp(layer="wall", shape="rect", x=rx + i, y=ry, x2=rx + i, y2=ry + rh - 1, wall=wall_val))


                ops.append(WorldDrawOp(layer="wall", shape="rect", x=rx + rw - 1 - i, y=ry, x2=rx + rw - 1 - i, y2=ry + rh - 1, wall=wall_val))





        elif cmd.type == "checkerboard":


            a = cmd.color_a or "primary"


            b = cmd.color_b or "error"


            s = int(cmd.cell_size or 1)


            s = max(1, min(20, s))





            # Apply as per-cell ops (bounded)


            for y in range(ry, ry + rh):


                for x in range(rx, rx + rw):


                    total_cells_touched += 1


                    if total_cells_touched > max_cells:


                        raise HTTPException(status_code=400, detail=f"script exceeded max_cells={max_cells}")


                    if _cell_blocked(world, x, y):


                        continue


                    use_a = ((x - rx) // s + (y - ry) // s) % 2 == 0


                    ops.append(WorldDrawOp(layer="color", shape="cell", x=x, y=y, color=a if use_a else b))





        elif cmd.type == "random_choice":


            palette = cmd.palette or ["primary", "error"]


            probs = cmd.probabilities


            if probs is not None and len(probs) != len(palette):


                raise HTTPException(status_code=400, detail="script.random_choice probabilities length must match palette")


            rng = random.Random(cmd.seed) if cmd.seed is not None else random





            for y in range(ry, ry + rh):


                for x in range(rx, rx + rw):


                    total_cells_touched += 1


                    if total_cells_touched > max_cells:


                        raise HTTPException(status_code=400, detail=f"script exceeded max_cells={max_cells}")


                    if _cell_blocked(world, x, y):


                        continue


                    c = rng.choices(palette, weights=probs, k=1)[0] if probs else rng.choice(palette)


                    ops.append(WorldDrawOp(layer="color", shape="cell", x=x, y=y, color=c))





        else:


            raise HTTPException(status_code=400, detail=f"Unknown script command: {cmd.type}")





    return ops








def _build_view(world: Dict, x: int, y: int, w: int, h: int) -> WorldViewResponse:


    world = _normalize_world_schema(world)


    width = int(world.get("width") or 0)


    height = int(world.get("height") or 0)


    x = max(0, min(x, max(0, width - 1)))


    y = max(0, min(y, max(0, height - 1)))


    w = max(1, min(w, 200, width - x))


    h = max(1, min(h, 200, height - y))





    walls_set = _world_walls_set(world)


    colors = world.get("colors") or {}





    walls_mat: List[List[bool]] = []


    colors_mat: List[List[Optional[WorldColorLabel]]] = []


    for yy in range(y, y + h):


        wrow = []


        crow = []


        for xx in range(x, x + w):


            k = _coord_key(xx, yy)


            wrow.append(k in walls_set)


            crow.append(colors.get(k))


        walls_mat.append(wrow)


        colors_mat.append(crow)





    placements = []


    for p in (world.get("agent_placements") or []):


        px, py = int(p.get("x") or 0), int(p.get("y") or 0)


        if x <= px < x + w and y <= py < y + h:


            placements.append(p)





    return WorldViewResponse(x=x, y=y, width=w, height=h, walls=walls_mat, colors=colors_mat, agent_placements=placements)








def _a_star_path(world: Dict, start_x: int, start_y: int, target_x: int, target_y: int):


    world = _normalize_world_schema(world)


    width = int(world.get("width") or 0)


    height = int(world.get("height") or 0)


    walls_set = _world_walls_set(world)


    colors = world.get("colors") or {}


    pois = world.get("pois") or []





    def _cell_in_poi(x: int, y: int) -> bool:


        try:


            for p in pois:


                shape = (p.get("shape") or "point")


                px = int(p.get("x") or 0)


                py = int(p.get("y") or 0)


                if shape == "rect":


                    w = int(p.get("w") or 0)


                    h = int(p.get("h") or 0)


                    if w > 0 and h > 0 and px <= x < px + w and py <= y < py + h:


                        return True


                elif shape == "cells":


                    cells = p.get("cells") or []


                    # cells list might be large; keep it bounded for path-cost usage.


                    for c in cells[:2000]:


                        if int(c.get("x") or 0) == x and int(c.get("y") or 0) == y:


                            return True


                else:


                    if px == x and py == y:


                        return True


        except Exception:


            return False


        return False





    # Only apply "stay-in-campus" bias if the world actually contains semantic markings.


    has_semantics = False


    if pois:


        has_semantics = True


    else:


        for v in colors.values():


            if v and v != "none":


                has_semantics = True


                break





    def _step_cost(x: int, y: int) -> int:


        if not has_semantics:


            return 1


        lbl = colors.get(_coord_key(x, y))


        if (lbl is None) or (lbl == "none"):


            # Penalize stepping onto completely unlabeled empty space to keep agents


            # within the campus semantic zone (roads/buildings), without hard blocking.


            if _cell_in_poi(x, y):


                return 1


            return 6


        return 1





    def in_bounds(x: int, y: int) -> bool:


        return 0 <= x < width and 0 <= y < height





    if not in_bounds(start_x, start_y) or not in_bounds(target_x, target_y):


        return None





    def is_blocked(x: int, y: int) -> bool:


        return _coord_key(x, y) in walls_set





    if is_blocked(start_x, start_y) or is_blocked(target_x, target_y):


        return None





    import heapq





    def h(x: int, y: int) -> int:


        return abs(x - target_x) + abs(y - target_y)





    start = (start_x, start_y)


    goal = (target_x, target_y)


    open_heap = [(h(*start), 0, start)]


    came_from: Dict[tuple, Optional[tuple]] = {start: None}


    g_score: Dict[tuple, int] = {start: 0}





    expansions = 0


    max_expansions = 200000


    dirs = [(1, 0), (-1, 0), (0, 1), (0, -1)]





    while open_heap:


        _, g, (x, y) = heapq.heappop(open_heap)


        if (x, y) == goal:


            break


        if g != g_score.get((x, y), None):


            continue





        expansions += 1


        if expansions > max_expansions:


            return None





        for dx, dy in dirs:


            nx, ny = x + dx, y + dy


            if not in_bounds(nx, ny):


                continue


            if is_blocked(nx, ny):


                continue


            ng = g + _step_cost(nx, ny)


            if ng < g_score.get((nx, ny), 10**12):


                g_score[(nx, ny)] = ng


                came_from[(nx, ny)] = (x, y)


                heapq.heappush(open_heap, (ng + h(nx, ny), ng, (nx, ny)))





    if goal not in came_from:


        return None





    path = []


    cur = goal


    while cur is not None:


        path.append(cur)


        cur = came_from.get(cur)


    path.reverse()


    return path





# --- Helper: Background Memory Saving ---


def background_save_memory(agent_id: str, prompt: str, content: str, run_id: str = None):


    try:


        # 1. Add to Vector DB (MemoryAgent)


        mem_agent = MemoryAgent(agent_id)


        context_str = f"In simulation run {run_id[:8] if run_id else 'chat'}, I was asked: '{prompt}'. I responded: '{content}'."


        mem_agent.add_observation(context_str, importance=1)





        # 2. Add to Simple List (for UI visibility)


        agent = AGENTS_DB.get(agent_id)


        if agent:


            if 'long_term_memory' not in agent: agent['long_term_memory'] = []


            # Avoid duplicates if possible (simple check)


            if context_str not in agent['long_term_memory']:


                agent['long_term_memory'].append(context_str)


                # We need to save AGENTS_DB.


                # Since this runs in background, we should be careful about race conditions with file writes.


                # But load_data/save_data are simple JSON dumps.


                # For now, we just save.


                save_data("agents.json", AGENTS_DB)


        print(f"Background memory saved for agent {agent_id}")


    except Exception as e:


        print(f"Failed to background save memory for agent {agent_id}: {e}")





oauth2_scheme = OAuth2PasswordBearer(tokenUrl="api/token")





# --- Auth Dependencies ---





async def get_current_user(token: str = Depends(oauth2_scheme)):


    credentials_exception = HTTPException(


        status_code=status.HTTP_401_UNAUTHORIZED,


        detail="Could not validate credentials",


        headers={"WWW-Authenticate": "Bearer"},


    )


    try:


        payload = jwt.decode(token, SECRET_KEY, algorithms=[ALGORITHM])


        username: str = payload.get("sub")


        if username is None:


            raise credentials_exception


    except JWTError:


        raise credentials_exception





    user_data = USERS_DB.get(username)


    if user_data is None:


        raise credentials_exception


    return UserInDB(**user_data)








@router.post("/worlds/{world_id}/ai_image", response_model=WorldAIImageResponse)


async def ai_image_world(


    world_id: str,


    req: WorldAIImageRequest,


    current_user: User = Depends(get_current_user),


):


    """Text → Image (AI_4) → Grid ops.





    Uses the AI_4 image model to generate a top-down pixel-art image and converts it into


    wall/color ops for the current viewport.


    """


    world = WORLDS_DB.get(world_id)


    if not world or world.get("user_id") != current_user.username:


        raise HTTPException(status_code=404, detail="World not found")


    _normalize_world_schema(world)





    view = _build_view(world, req.x, req.y, req.w, req.h)





    agent = _find_agent_for_image(current_user, req.agent_id)


    if not agent:


        raise HTTPException(status_code=404, detail="Image agent not found (expected AI_4)")


    if agent.get("provider") != "custom":


        raise HTTPException(status_code=400, detail="Image agent must be provider=custom")





    # Prompt tuned for easy conversion: one pixel ≈ one tile, limited colors.


    image_prompt = (


        "Generate a TOP-DOWN pixel art map image. No perspective, no text. "


        "The image will be converted into a tile grid where 1 pixel = 1 tile. "


        "Use crisp shapes with solid colors (avoid gradients).\n\n"


        "Color key (important):\n"


        "- BLACK (#000000): walls/obstacles\n"


        "- WHITE (#FFFFFF): empty\n"


        "- GREEN (grass): main ground\n"


        "- CYAN or LIGHT BLUE: field lines/markings\n\n"


        f"Target grid size: {view.width}x{view.height} tiles.\n\n"


        f"User request: {req.prompt}"


    )





    gen_res = _invoke_custom_agent_raw(agent, image_prompt)





    # Try to extract image url from: content (if it is a json list), adapter extraction on full dict, or raw payload.


    image_url = _parse_first_image_url(gen_res.get("content"))


    if not image_url:


        extracted = extract_content_from_raw(gen_res) or extract_content_from_raw(gen_res.get("raw"))


        image_url = _parse_first_image_url(extracted)





    if not image_url:


        raise HTTPException(status_code=500, detail=f"Image generation returned no image URL. Response keys={list(gen_res.keys())}")





    # Download and store image under uploads/generated


    try:


        img_bytes = _download_image_bytes(image_url)


    except Exception as e:


        raise HTTPException(status_code=502, detail=f"Failed to download generated image: {e}")





    try:


        os.makedirs("uploads/generated", exist_ok=True)


        img_id = str(uuid.uuid4())


        rel_path = f"uploads/generated/{img_id}.png"


        with open(rel_path, "wb") as f:


            f.write(img_bytes)


        served_url = f"/uploads/generated/{img_id}.png"


    except Exception as e:


        raise HTTPException(status_code=500, detail=f"Failed to store generated image: {e}")





    try:


        img = Image.open(io.BytesIO(img_bytes))


    except Exception as e:


        raise HTTPException(status_code=500, detail=f"Generated image is not a valid image: {e}")





    ops = _image_to_world_ops(img, view.x, view.y, view.width, view.height)


    world = _apply_draw_ops(world, ops)


    WORLDS_DB[world_id] = world


    save_data("worlds.json", WORLDS_DB)





    new_view = _build_view(world, view.x, view.y, view.width, view.height)


    return WorldAIImageResponse(agent_id=agent.get("id") or "", image_url=served_url, ops=ops, view=new_view)





# --- Auth Endpoints ---





def _normalize_username(raw: str) -> str:


    return (raw or "").strip()








def _get_user_dict_loose(username: str):


    """Lookup user by username with small quality-of-life normalization.





    - Strips leading/trailing whitespace


    - Falls back to case-insensitive match if exact key is not found


    """


    u = _normalize_username(username)


    if not u:


        return None, None





    user_dict = USERS_DB.get(u)


    if user_dict:


        return u, user_dict





    u_cf = u.casefold()


    for k, v in USERS_DB.items():


        if isinstance(k, str) and k.casefold() == u_cf:


            return k, v


    return u, None





@router.post("/register", response_model=Token)


async def register(user: UserCreate):


    username = _normalize_username(user.username)


    print(f"Registering user: {username}")


    if not username:


        raise HTTPException(status_code=400, detail="Username is required")





    existing_key, existing = _get_user_dict_loose(username)


    if existing:


        print("Username already exists")


        raise HTTPException(status_code=400, detail="Username already registered")





    try:


        print("Hashing password...")


        hashed_password = get_password_hash(user.password)


        print("Password hashed.")


        user_in_db = UserInDB(username=username, hashed_password=hashed_password)


        USERS_DB[username] = user_in_db.dict()


        print("Saving user to DB...")


        save_data("users.json", USERS_DB)


        print("User saved.")





        access_token_expires = timedelta(minutes=ACCESS_TOKEN_EXPIRE_MINUTES)


        access_token = create_access_token(


            data={"sub": username}, expires_delta=access_token_expires


        )


        print("Token created.")


        return {"access_token": access_token, "token_type": "bearer"}


    except Exception as e:


        print(f"Error during registration: {e}")


        import traceback


        traceback.print_exc()


        raise HTTPException(status_code=500, detail=f"Registration failed: {str(e)}")





@router.post("/token", response_model=Token)


async def login_for_access_token(form_data: OAuth2PasswordRequestForm = Depends()):


    _, user_dict = _get_user_dict_loose(form_data.username)


    if not user_dict:


        raise HTTPException(status_code=400, detail="Incorrect username or password")





    user = UserInDB(**user_dict)


    if not verify_password(form_data.password, user.hashed_password):


        raise HTTPException(status_code=400, detail="Incorrect username or password")





    access_token_expires = timedelta(minutes=ACCESS_TOKEN_EXPIRE_MINUTES)


    access_token = create_access_token(


        data={"sub": user.username}, expires_delta=access_token_expires


    )


    return {"access_token": access_token, "token_type": "bearer"}





