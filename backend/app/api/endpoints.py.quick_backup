        pois=world.get("pois") or [],


        identities=world.get("identities") or [],


        agent_identities=world.get("agent_identities") or {},


    )








@router.put("/worlds/{world_id}", response_model=WorldResponse)


async def update_world(world_id: str, req: WorldUpdateRequest, current_user: User = Depends(get_current_user)):


    world = WORLDS_DB.get(world_id)


    if not world or world.get("user_id") != current_user.username:


        raise HTTPException(status_code=404, detail="World not found")





    _normalize_world_schema(world)





    if req.name is not None:


        world["name"] = req.name





    # Legacy support: allow small dense grid update (<=200x200) and migrate.


    if req.grid is not None:


        if world.get("width", 0) > 200 or world.get("height", 0) > 200:


            raise HTTPException(status_code=400, detail="Legacy grid updates only supported for worlds up to 200x200")


        _validate_grid(req.grid, world["width"], world["height"])


        # Convert grid to layers.


        walls = set()


        colors: Dict[str, WorldColorLabel] = {}


        for y, row in enumerate(req.grid):


            for x, cell in enumerate(row):


                if cell == "wall":


                    walls.add(_coord_key(x, y))


                elif cell == "court":


                    colors[_coord_key(x, y)] = "neutral"


        world["walls"] = sorted(walls)


        world["colors"] = colors





    if req.agent_placements is not None:


        # Basic validation only


        world["agent_placements"] = [p.dict() for p in req.agent_placements]





    if getattr(req, "pois", None) is not None:


        world["pois"] = [p.dict() for p in (req.pois or [])]





    if getattr(req, "identities", None) is not None:


        world["identities"] = [i.dict() for i in (req.identities or [])]





    if getattr(req, "agent_identities", None) is not None:


        world["agent_identities"] = dict(req.agent_identities or {})





    WORLDS_DB[world_id] = world


    save_data("worlds.json", WORLDS_DB)


    return WorldResponse(


        id=world.get("id"),


        name=world.get("name"),


        width=world.get("width"),


        height=world.get("height"),


        walls_count=len(world.get("walls") or []),


        colors_count=len(world.get("colors") or {}),


        agent_placements=world.get("agent_placements") or [],


        pois=world.get("pois") or [],


        identities=world.get("identities") or [],


        agent_identities=world.get("agent_identities") or {},


    )








