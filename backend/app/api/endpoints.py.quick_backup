@router.post("/worlds/{world_id}/identities", response_model=WorldIdentity)


async def create_world_identity(world_id: str, req: WorldIdentityCreateRequest, current_user: User = Depends(get_current_user)):


    world = WORLDS_DB.get(world_id)


    if not world or world.get("user_id") != current_user.username:


        raise HTTPException(status_code=404, detail="World not found")


    _normalize_world_schema(world)





    identity = WorldIdentity(


        id=str(uuid.uuid4()),


        name=req.name,


        kind=req.kind,


        description=req.description,


        schedule=req.schedule or [],


    )


    identities = world.get("identities") or []


    identities.append(identity.dict())


    world["identities"] = identities


    WORLDS_DB[world_id] = world


    save_data("worlds.json", WORLDS_DB)


    return identity








@router.put("/worlds/{world_id}/identities/{identity_id}", response_model=WorldIdentity)


async def update_world_identity(world_id: str, identity_id: str, req: WorldIdentityUpdateRequest, current_user: User = Depends(get_current_user)):


    world = WORLDS_DB.get(world_id)


    if not world or world.get("user_id") != current_user.username:


        raise HTTPException(status_code=404, detail="World not found")


    _normalize_world_schema(world)





    identities = world.get("identities") or []


    found = None


    for it in identities:


        if it.get("id") == identity_id:


            found = it


            break


    if not found:


        raise HTTPException(status_code=404, detail="Identity not found")





    if req.name is not None:


        found["name"] = req.name


    if req.kind is not None:


        found["kind"] = req.kind


    if req.description is not None:


        found["description"] = req.description


    if req.schedule is not None:


        found["schedule"] = [x.dict() for x in (req.schedule or [])]





    world["identities"] = identities


    WORLDS_DB[world_id] = world


    save_data("worlds.json", WORLDS_DB)


    return WorldIdentity(**found)








@router.delete("/worlds/{world_id}/identities/{identity_id}")


async def delete_world_identity(world_id: str, identity_id: str, current_user: User = Depends(get_current_user)):


    world = WORLDS_DB.get(world_id)


    if not world or world.get("user_id") != current_user.username:


        raise HTTPException(status_code=404, detail="World not found")


    _normalize_world_schema(world)





    identities = world.get("identities") or []


    new_identities = [i for i in identities if i.get("id") != identity_id]


    if len(new_identities) == len(identities):


        raise HTTPException(status_code=404, detail="Identity not found")





    world["identities"] = new_identities


    # Remove assignments pointing to deleted identity.


    agent_identities = world.get("agent_identities") or {}


    agent_identities = {k: v for (k, v) in agent_identities.items() if v != identity_id}


    world["agent_identities"] = agent_identities





    WORLDS_DB[world_id] = world


    save_data("worlds.json", WORLDS_DB)


    return {"message": "Identity deleted"}








@router.post("/worlds/{world_id}/agent_identity")


async def set_world_agent_identity(world_id: str, req: SetWorldAgentIdentityRequest, current_user: User = Depends(get_current_user)):


    world = WORLDS_DB.get(world_id)


    if not world or world.get("user_id") != current_user.username:


        raise HTTPException(status_code=404, detail="World not found")


    _normalize_world_schema(world)





    # validate agent exists


    a = AGENTS_DB.get(req.agent_id)


    if not a or a.get("user_id") != current_user.username:


        raise HTTPException(status_code=404, detail="Agent not found")





    # validate identity exists


    identity_ids = {i.get("id") for i in (world.get("identities") or [])}


    if req.identity_id not in identity_ids:


        raise HTTPException(status_code=400, detail="Identity not found in this world")





    agent_identities = world.get("agent_identities") or {}


    agent_identities[str(req.agent_id)] = str(req.identity_id)


    world["agent_identities"] = agent_identities


    WORLDS_DB[world_id] = world


    save_data("worlds.json", WORLDS_DB)


    return {"message": "Agent identity set", "agent_id": req.agent_id, "identity_id": req.identity_id}








@router.post("/worlds/{world_id}/pick_poi_path", response_model=PickPOIPathResponse)


async def pick_poi_path(world_id: str, req: PickPOIPathRequest, current_user: User = Depends(get_current_user)):


    """Pick a POI by color label(s), then return a reachable nearby target + its path.





    Intended for agent auto-roam: avoid random goals; go to semantic zones.


    Note: POI-colored cells may be blocked (e.g. buildings). We search nearby walkable cells.


    """


    world = WORLDS_DB.get(world_id)


    if not world or world.get("user_id") != current_user.username:


        raise HTTPException(status_code=404, detail="World not found")





    _normalize_world_schema(world)





    placements = world.get("agent_placements") or []


    start = None


    for p in placements:


        if p.get("agent_id") == req.agent_id:


            start = (int(p.get("x") or 0), int(p.get("y") or 0))


            break


    if start is None:


        raise HTTPException(status_code=404, detail="Agent not placed in world")





    labels = [x for x in (req.labels or []) if x and x != "none"]


    colors = world.get("colors") or {}





    seed_cells: List[tuple[int, int, WorldColorLabel]] = []


    if labels:


        allowed = set(labels)


        for k, v in colors.items():


            if v not in allowed:


                continue


            try:


                sx, sy = _parse_coord_key(k)


            except Exception:


                continue


            seed_cells.append((sx, sy, v))





    if not seed_cells:


        raise HTTPException(status_code=400, detail="No POI cells found for requested labels")





    sx0, sy0 = start


    if req.strategy == "nearest":


        seed_cells.sort(key=lambda t: abs(t[0] - sx0) + abs(t[1] - sy0))


        seed_cells = seed_cells[: req.max_seed_cells]


    else:


        if len(seed_cells) > req.max_seed_cells:


            seed_cells = random.sample(seed_cells, req.max_seed_cells)


        random.shuffle(seed_cells)





    attempts = 0


    for (px, py, lbl) in seed_cells:


        candidates = _nearby_candidates(world, px, py, req.max_radius)


        # If POI itself is walkable, _nearby_candidates returns it first.


        for (tx, ty) in candidates:


            attempts += 1


            if attempts > req.max_attempts:


                break


            path = _a_star_path(world, sx0, sy0, tx, ty)


            if not path:


                continue


            return PickPOIPathResponse(


                label=lbl,


                poi=PathPoint(x=px, y=py),


                target=PathPoint(x=tx, y=ty),


                path=[PathPoint(x=x, y=y) for (x, y) in path],


            )


        if attempts > req.max_attempts:


            break





    raise HTTPException(status_code=400, detail="No reachable POI target found")








@router.post("/worlds/{world_id}/encounter_dialogue", response_model=WorldEncounterDialogueResponse)


async def world_encounter_dialogue(


    world_id: str,


    req: WorldEncounterDialogueRequest,


    current_user: User = Depends(get_current_user),


):


    """Generate a short dialogue for two agents who encounter each other in the world.





    This is intended for the World UI: show returned lines as chat bubbles above agents.


    """


    world = WORLDS_DB.get(world_id)


    if not world or world.get("user_id") != current_user.username:


        raise HTTPException(status_code=404, detail="World not found")


    _normalize_world_schema(world)





    # Ensure both agents exist and belong to the user.


    a = AGENTS_DB.get(req.agent_a_id)


    b = AGENTS_DB.get(req.agent_b_id)


    if not a or a.get("user_id") != current_user.username:


        raise HTTPException(status_code=404, detail="Agent A not found")


    if not b or b.get("user_id") != current_user.username:


        raise HTTPException(status_code=404, detail="Agent B not found")





    placements = world.get("agent_placements") or []


    pos: Dict[str, tuple[int, int]] = {}


    for p in placements:


        aid = p.get("agent_id")


        if not aid:


            continue


        try:


            pos[aid] = (int(p.get("x") or 0), int(p.get("y") or 0))


        except Exception:


            continue





    if req.agent_a_id not in pos or req.agent_b_id not in pos:


        raise HTTPException(status_code=400, detail="Both agents must be placed in the world")





    a_name = a.get("name") or req.agent_a_id


    b_name = b.get("name") or req.agent_b_id


    ax, ay = pos[req.agent_a_id]


    bx, by = pos[req.agent_b_id]





    max_turns = int(req.max_turns or 2)


    max_turns = max(2, min(6, max_turns))





    topic = (req.topic or "").strip() or "在校园里偶遇，先打招呼，再交流一个学习相关的小建议。"





    def extract_text_only(val: object) -> str:


        if val is None:


            return ""


        if not isinstance(val, str):


            return str(val)


        s = val.strip()


        # If the model returned OpenAI-style JSON content list, pull out text parts.


        if s.startswith("[") and s.endswith("]"):


            try:


                items = json.loads(s)


                if isinstance(items, list):


                    texts = []


                    for it in items:


                        if isinstance(it, dict) and it.get("type") == "text":


                            t = it.get("text")


                            if isinstance(t, str) and t.strip():


                                texts.append(t.strip())


                    if texts:


                        return " ".join(texts).strip()


            except Exception:


                pass


        return s





    def invoke_agent_once(agent: Dict, line_prompt: str) -> str:


        provider = agent.get("provider")


        messages = [{"role": "user", "content": line_prompt}]


        persona = agent.get("persona")


        if persona:


            messages = [{"role": "system", "content": persona}] + messages





        if provider in ["deepseek", "zhipu"]:


            res = ai_chat(


                messages_or_prompt=messages,


                model=agent.get("model"),


                api_key=agent.get("api_key"),


                base_url=agent.get("base_url"),


                temperature=0.7,


                max_tokens=330,


            )


            return extract_text_only((res or {}).get("content") if isinstance(res, dict) else str(res))





        if provider == "custom":


            code_str = agent.get("usage_example")


            if not code_str:


                return ""


            local_scope = {"json": json}


            exec(code_str, local_scope)


            invoke_func = local_scope.get("invoke_custom_agent")


            if not invoke_func:


                return ""


            result = invoke_func(


                messages=messages,


                api_key=agent.get("api_key"),


                base_url=agent.get("base_url"),


                model=agent.get("model"),


                temperature=0.7,


            )


            if isinstance(result, dict):


                return extract_text_only(result.get("content") or "")


            return extract_text_only(str(result))





        return ""





    turns: List[WorldEncounterDialogueTurn] = []


    transcript = ""





    for i in range(max_turns):


        speaker = a if i % 2 == 0 else b


        speaker_id = req.agent_a_id if i % 2 == 0 else req.agent_b_id


        listener_name = b_name if speaker_id == req.agent_a_id else a_name


        speaker_name = a_name if speaker_id == req.agent_a_id else b_name


        sx, sy = pos[speaker_id]


        lx, ly = (bx, by) if speaker_id == req.agent_a_id else (ax, ay)





        line_prompt = (


            f"你是{speaker_name}，校园里的学生。你在({sx},{sy})附近遇见了{listener_name}（在({lx},{ly})）。\n"


            f"话题：{topic}\n\n"


            "要求：\n"


            "- 只输出一句你要说的话\n"


            "- 尽量短（<=20字）\n"


            "- 不要旁白/引号/表情\n\n"


            f"已发生对话：\n{transcript}\n"


            "现在你说："


        )





        text = invoke_agent_once(speaker, line_prompt)


        text = re.sub(r"\s+", " ", (text or "").strip())


        if len(text) > 80:


            text = text[:80]


        if not text:


            text = "你好" if i == 0 else "嗯嗯"





        turns.append(WorldEncounterDialogueTurn(agent_id=speaker_id, text=text))


        transcript += f"{speaker_name}: {text}\n"





    # Persist as a world event (for world timeline / replay).


    _append_world_event(


        current_user,


        world,


        "encounter_dialogue",


        {


            "topic": topic,


            "agent_a": {"id": req.agent_a_id, "name": a_name, "x": ax, "y": ay},


            "agent_b": {"id": req.agent_b_id, "name": b_name, "x": bx, "y": by},


            "turns": [t.dict() for t in turns],


            "transcript": transcript.strip(),


        },


    )





    # Write into each agent's chat history and long-term memory.


    encounter_prompt = f"世界偶遇：{world.get('name') or world_id}，话题：{topic}"


    now_ts = time.time()


    for agent_obj, self_name, other_name, self_pos in [


        (a, a_name, b_name, (ax, ay)),


        (b, b_name, a_name, (bx, by)),


    ]:


        agent_id = agent_obj.get("id")


        if not agent_id:


            continue





        _append_agent_chat_history(


            agent_id,


            {


                "role": "assistant",


                "content": transcript.strip(),


                "prompt": encounter_prompt,


                "timestamp": now_ts,


            },


        )





        mem_text = (


            f"[世界:{world.get('name') or world_id}] 我({self_name})在{self_pos}附近遇到{other_name}。"


            f"话题：{topic}。对话记录：{transcript.strip()}"


        )


        _inject_agent_memory_side_effect(agent_obj, mem_text, importance=1)





    return WorldEncounterDialogueResponse(turns=turns)








@router.get("/worlds/{world_id}/events", response_model=WorldEventsResponse)


async def get_world_events(world_id: str, limit: int = 200, current_user: User = Depends(get_current_user)):


    world = WORLDS_DB.get(world_id)


    if not world or world.get("user_id") != current_user.username:


        raise HTTPException(status_code=404, detail="World not found")





    limit = int(limit or 200)


    limit = max(1, min(1000, limit))


    events = WORLD_EVENTS_DB.get(world_id, [])


    # newest first


    events = list(reversed(events[-limit:]))


    return WorldEventsResponse(events=[WorldEventRecord(**e) for e in events])








@router.post("/worlds/{world_id}/ai_draw", response_model=WorldAIDrawResponse)


async def ai_draw_world(


    world_id: str,


    req: WorldAIDrawRequest,


    current_user: User = Depends(get_current_user),


):


    world = WORLDS_DB.get(world_id)


    if not world or world.get("user_id") != current_user.username:


        raise HTTPException(status_code=404, detail="World not found")


    _normalize_world_schema(world)





    view = _build_view(world, req.x, req.y, req.w, req.h)





    system_prompt = """


You are a WORLD MAP PAINTER. You output ONLY valid JSON.





You will be given a world size and a target viewport rectangle (x,y,w,h). You must propose drawing operations to modify the map.





World representation is TWO layers:


1) wall layer: boolean wall blocks movement


2) color layer: semantic label for display





Allowed colors: ["none","neutral","primary","success","warning","error","info"]. Use "none" to clear color.





Output JSON format:


{


  "ops": [


    {"layer":"wall","shape":"rect","x":0,"y":0,"x2":10,"y2":0,"wall":true},


    {"layer":"color","shape":"rect","x":1,"y":1,"x2":9,"y2":8,"color":"neutral"}


  ]


}





Rules:


- All coordinates must stay INSIDE the provided viewport bounds.


- Keep ops <= max_ops.


- Prefer rect/line over thousands of single cells.


""".strip()





    user_prompt = {


        "instruction": req.prompt,


        "world_size": {"width": world.get("width"), "height": world.get("height")},


        "viewport": {"x": view.x, "y": view.y, "w": view.width, "h": view.height},


        "current_view": {"walls": view.walls, "colors": view.colors},


        "max_ops": req.max_ops,


    }





    res = ai_chat(


        messages_or_prompt=[


            {"role": "system", "content": system_prompt},


            {"role": "user", "content": json.dumps(user_prompt, ensure_ascii=False)},


        ],


        temperature=0.3,


        max_tokens=4500,


    )





    raw_content = res.get("content", "") if isinstance(res, dict) else str(res)


    logging.info(f"[ai_draw] raw model output (first 800 chars): {str(raw_content)[:800]}")





    try:


        parsed = clean_and_parse_json(raw_content)


    except Exception as e:


        raise HTTPException(status_code=500, detail=f"AI draw JSON parse failed: {e}")





    ops_raw = parsed.get("ops") if isinstance(parsed, dict) else None


    if not isinstance(ops_raw, list):


        raise HTTPException(status_code=500, detail="AI draw response missing 'ops' list")





    ops: List[WorldDrawOp] = []


    filtered = {"parse": 0, "missing": 0, "oob": 0}





    vx1, vy1 = view.x, view.y


    vx2, vy2 = view.x + view.width - 1, view.y + view.height - 1





    def in_v(x: int, y: int) -> bool:


        return vx1 <= x <= vx2 and vy1 <= y <= vy2





    def clamp_x(x: int) -> int:


        return max(vx1, min(vx2, x))





    def clamp_y(y: int) -> int:


        return max(vy1, min(vy2, y))





    for item in ops_raw[: req.max_ops]:


        try:


            op = WorldDrawOp(**item)


        except Exception:


            filtered["parse"] += 1


            continue





        if op.shape == "cell":


            if op.x is None or op.y is None:


                filtered["missing"] += 1


                continue


            if not in_v(op.x, op.y):


                filtered["oob"] += 1


                continue





        elif op.shape == "cells":


            if not op.cells:


                filtered["missing"] += 1


                continue


            # Keep only in-bounds cells


            kept = [p for p in op.cells if in_v(p.x, p.y)]


            if not kept:


                filtered["oob"] += 1


                continue


            op.cells = kept





        elif op.shape == "rect":


            if op.x is None or op.y is None or op.x2 is None or op.y2 is None:


                filtered["missing"] += 1


                continue


            # Clip rectangle into viewport bounds instead of dropping.


            x1, y1 = clamp_x(op.x), clamp_y(op.y)


            x2, y2 = clamp_x(op.x2), clamp_y(op.y2)


            op.x, op.y, op.x2, op.y2 = x1, y1, x2, y2





        elif op.shape == "line":


            if op.x is None or op.y is None or op.x2 is None or op.y2 is None:


                filtered["missing"] += 1


                continue


            # For line we require both endpoints to be in bounds (avoid weird clipping artifacts).


            if not (in_v(op.x, op.y) and in_v(op.x2, op.y2)):


                filtered["oob"] += 1


                continue





        ops.append(op)





    if not ops:


        raise HTTPException(


            status_code=400,


            detail=(


                "AI returned no valid draw ops for this viewport. "


                f"Filtered counts={filtered}. "


                "Try: (1) ensure viewport is where you want to draw, (2) ask for a few rect ops, "


                "(3) keep coordinates within viewport bounds."


            ),


        )





    world = _apply_draw_ops(world, ops)


    WORLDS_DB[world_id] = world


    save_data("worlds.json", WORLDS_DB)





    new_view = _build_view(world, view.x, view.y, view.width, view.height)


    return WorldAIDrawResponse(ops=ops, view=new_view)








@router.post("/worlds/{world_id}/ai_script", response_model=WorldAIScriptResponse)


async def ai_script_world(


    world_id: str,


    req: WorldAIScriptRequest,


    current_user: User = Depends(get_current_user),


):


    world = WORLDS_DB.get(world_id)


    if not world or world.get("user_id") != current_user.username:


        raise HTTPException(status_code=404, detail="World not found")


    _normalize_world_schema(world)





    view = _build_view(world, req.x, req.y, req.w, req.h)





    system_prompt = """


You are a WORLD MAP SCRIPT WRITER. Output ONLY valid JSON.





You must generate a list of SAFE, RESTRICTED drawing commands that will be executed by the server.


All drawing must stay inside the provided viewport bounds.





Command schema:


{


  "commands": [


    {"type":"fill_rect", "color":"success"},


    {"type":"border_walls", "thickness":1, "wall":true},


    {"type":"checkerboard", "color_a":"primary", "color_b":"error", "cell_size":1},


    {"type":"random_choice", "palette":["primary","error"], "probabilities":[0.5,0.5], "seed":123}


  ]


}





Rules:


- Output at most max_commands commands.


- Do not use coordinates outside the viewport.


- Prefer high-level commands (checkerboard/random_choice) for complex patterns.


""".strip()





    user_payload = {


        "instruction": req.prompt,


        "viewport": {"x": view.x, "y": view.y, "w": view.width, "h": view.height},


        "world_size": {"width": world.get("width"), "height": world.get("height")},


        "max_commands": req.max_commands,


        "max_cells": req.max_cells,


    }





    res = ai_chat(


        messages_or_prompt=[


            {"role": "system", "content": system_prompt},


            {"role": "user", "content": json.dumps(user_payload, ensure_ascii=False)},


        ],


        temperature=0.2,


        max_tokens=3000,


    )





    raw = res.get("content", "") if isinstance(res, dict) else str(res)


    logging.info(f"[ai_script] raw model output (first 800 chars): {str(raw)[:800]}")





    try:


        parsed = clean_and_parse_json(raw)


    except Exception as e:


        raise HTTPException(status_code=500, detail=f"AI script JSON parse failed: {e}")





    cmds_raw = parsed.get("commands") if isinstance(parsed, dict) else None


    if not isinstance(cmds_raw, list):


        raise HTTPException(status_code=500, detail="AI script response missing 'commands' list")





    commands: List[WorldScriptCommand] = []


    for item in cmds_raw[: req.max_commands]:


        try:


            commands.append(WorldScriptCommand(**item))


        except Exception:


            continue





    if not commands:


        raise HTTPException(status_code=400, detail="AI returned 0 valid script commands")





    ops = _execute_world_script(world, view, commands, max_cells=req.max_cells)


    world = _apply_draw_ops(world, ops)


    WORLDS_DB[world_id] = world


    save_data("worlds.json", WORLDS_DB)





    new_view = _build_view(world, view.x, view.y, view.width, view.height)


    return WorldAIScriptResponse(commands=commands, view=new_view)








@router.post("/worlds/{world_id}/ai_generate", response_model=WorldAIGenerateResponse)


async def ai_generate_world(


    world_id: str,


    req: WorldAIGenerateRequest,


    current_user: User = Depends(get_current_user),


):


    """Unified AI generation endpoint.





    - mode=script: AI outputs restricted commands -> executed into ops


    - mode=ops: AI outputs ops directly (like ai_draw)


    - mode=auto: AI first outputs commands (Planner), applies them, then outputs ops (Painter) to refine


    """


    world = WORLDS_DB.get(world_id)


    if not world or world.get("user_id") != current_user.username:


        raise HTTPException(status_code=404, detail="World not found")


    _normalize_world_schema(world)





    view = _build_view(world, req.x, req.y, req.w, req.h)


    all_commands: List[WorldScriptCommand] = []


    all_ops: List[WorldDrawOp] = []





    drawing_guide = """


GRID DRAWING GUIDE (IMPORTANT)





You are drawing a TILE GRID. One tile = one cell.





Viewport:


- You MUST draw only inside the given viewport bounds.


- Coordinates are ABSOLUTE world coordinates.





Layers:


- color layer: visual only. Use this for lines/markings.


- wall layer: blocks movement. Use sparingly (e.g., goal posts / obstacles).





Colors:


- grass: success


- lines/markings: info (high contrast)


- neutral areas: neutral





Soccer field recipe (what users expect to SEE):


- grass fill (success)


- boundary lines (info)


- center line (info)


- center circle (info)


- two penalty boxes + two goal areas (info)


- goal openings on left/right boundary + goal posts (wall)





If uncertain: draw the big shapes first (fill + border + center line), then add details.


""".strip()





    if req.mode in ("script", "auto"):


        planner_system = """


You are the WORLD PLANNER (Script Writer). Output ONLY valid JSON.


Generate a list of SAFE drawing commands to satisfy the instruction.





{drawing_guide}





Schema:


{"commands":[


    {"type":"fill_rect","color":"success"},


    {"type":"border_walls","thickness":1,"wall":true},


    {"type":"checkerboard","color_a":"primary","color_b":"error","cell_size":1},


    {"type":"random_choice","palette":["primary","error"],"probabilities":[0.5,0.5],"seed":123}


]}





Rules:


- Commands must operate only within the viewport bounds.


- Prefer high-level commands for complex patterns.


- Output at most max_commands.





Example (soccer field base inside viewport):


{"commands":[


    {"type":"fill_rect","color":"success"}


]}


""".strip()


        planner_system = planner_system.replace("{drawing_guide}", drawing_guide)





        planner_user = {


            "instruction": req.prompt,


            "viewport": {"x": view.x, "y": view.y, "w": view.width, "h": view.height},


            "world_size": {"width": world.get("width"), "height": world.get("height")},


            "max_commands": req.max_commands,


            "max_cells": req.max_cells,


        }


        planner_res = ai_chat(


            messages_or_prompt=[


                {"role": "system", "content": planner_system},


                {"role": "user", "content": json.dumps(planner_user, ensure_ascii=False)},


            ],


            temperature=0.2,


            max_tokens=3000,


        )


        raw = planner_res.get("content", "") if isinstance(planner_res, dict) else str(planner_res)


        logging.info(f"[ai_generate planner] raw (first 800): {str(raw)[:800]}")





        try:


            parsed = clean_and_parse_json(raw)


        except Exception as e:


            raise HTTPException(status_code=500, detail=f"AI planner JSON parse failed: {e}")





        cmds_raw = parsed.get("commands") if isinstance(parsed, dict) else None


        if not isinstance(cmds_raw, list):


            raise HTTPException(status_code=500, detail="AI planner response missing 'commands' list")





        commands: List[WorldScriptCommand] = []


        for item in cmds_raw[: req.max_commands]:


            try:


                commands.append(WorldScriptCommand(**item))


            except Exception:


                continue





        if commands:


            ops_from_script = _execute_world_script(world, view, commands, max_cells=req.max_cells)


            world = _apply_draw_ops(world, ops_from_script)


            WORLDS_DB[world_id] = world


            save_data("worlds.json", WORLDS_DB)


            view = _build_view(world, view.x, view.y, view.width, view.height)


            all_commands.extend(commands)


            all_ops.extend(ops_from_script)





    if req.mode in ("ops", "auto"):


        painter_system = """


You are the WORLD PAINTER (Ops Generator). Output ONLY valid JSON.





{drawing_guide}





You can modify two layers:


- wall layer (blocks movement): set wall true/false


- color layer: set color label





Allowed colors: ["none","neutral","primary","success","warning","error","info"].





Output schema:


{"ops":[


  {"layer":"wall","shape":"rect","x":0,"y":0,"x2":10,"y2":0,"wall":true},


  {"layer":"color","shape":"rect","x":1,"y":1,"x2":9,"y2":8,"color":"neutral"}


]}





Rules:


- All coordinates must be inside the viewport.


- Use rect/line when possible.


- Output at most max_ops.





Example (soccer field markings inside viewport):


{"ops":[


    {"layer":"color","shape":"rect","x":100,"y":50,"x2":199,"y2":113,"color":"success"},


    {"layer":"color","shape":"rect","x":100,"y":50,"x2":199,"y2":50,"color":"info"},


    {"layer":"color","shape":"rect","x":100,"y":113,"x2":199,"y2":113,"color":"info"},


    {"layer":"color","shape":"rect","x":100,"y":50,"x2":100,"y2":113,"color":"info"},


    {"layer":"color","shape":"rect","x":199,"y":50,"x2":199,"y2":113,"color":"info"},


    {"layer":"color","shape":"line","x":150,"y":51,"x2":150,"y2":112,"color":"info"},


    {"layer":"wall","shape":"cell","x":100,"y":80,"wall":true},


    {"layer":"wall","shape":"cell","x":199,"y":80,"wall":true}


]}


""".strip()


        painter_system = painter_system.replace("{drawing_guide}", drawing_guide)





        painter_user = {


            "instruction": req.prompt,


            "viewport": {"x": view.x, "y": view.y, "w": view.width, "h": view.height},


            "current_view": {"walls": view.walls, "colors": view.colors},


            "world_size": {"width": world.get("width"), "height": world.get("height")},


            "max_ops": req.max_ops,


        }





        painter_res = ai_chat(


            messages_or_prompt=[


                {"role": "system", "content": painter_system},


                {"role": "user", "content": json.dumps(painter_user, ensure_ascii=False)},


            ],


            temperature=0.25,


            max_tokens=3750,


        )


        raw2 = painter_res.get("content", "") if isinstance(painter_res, dict) else str(painter_res)


        logging.info(f"[ai_generate painter] raw (first 800): {str(raw2)[:800]}")





        try:


            parsed2 = clean_and_parse_json(raw2)


        except Exception as e:


            raise HTTPException(status_code=500, detail=f"AI painter JSON parse failed: {e}")





        ops_raw = parsed2.get("ops") if isinstance(parsed2, dict) else None


        if not isinstance(ops_raw, list):


            raise HTTPException(status_code=500, detail="AI painter response missing 'ops' list")





        # Reuse the same bounding/validation logic as ai_draw by constructing WorldDrawOp and filtering.


        bounded_ops: List[WorldDrawOp] = []


        vx1, vy1 = view.x, view.y


        vx2, vy2 = view.x + view.width - 1, view.y + view.height - 1





        def in_v(x: int, y: int) -> bool:


            return vx1 <= x <= vx2 and vy1 <= y <= vy2





        def clamp_x(x: int) -> int:


            return max(vx1, min(vx2, x))





        def clamp_y(y: int) -> int:


            return max(vy1, min(vy2, y))





        for item in ops_raw[: req.max_ops]:


            try:


                op = WorldDrawOp(**item)


            except Exception:


                continue





            if op.shape == "cell":


                if op.x is None or op.y is None or not in_v(op.x, op.y):


                    continue


            elif op.shape == "cells":


                if not op.cells:


                    continue


                kept = [p for p in op.cells if in_v(p.x, p.y)]


                if not kept:


                    continue


                op.cells = kept


            elif op.shape == "rect":


                if op.x is None or op.y is None or op.x2 is None or op.y2 is None:


                    continue


                op.x, op.y, op.x2, op.y2 = clamp_x(op.x), clamp_y(op.y), clamp_x(op.x2), clamp_y(op.y2)


            elif op.shape == "line":


                if op.x is None or op.y is None or op.x2 is None or op.y2 is None:


                    continue


                if not (in_v(op.x, op.y) and in_v(op.x2, op.y2)):


                    continue





            bounded_ops.append(op)





        if bounded_ops:


            world = _apply_draw_ops(world, bounded_ops)


            WORLDS_DB[world_id] = world


            save_data("worlds.json", WORLDS_DB)


            view = _build_view(world, view.x, view.y, view.width, view.height)


            all_ops.extend(bounded_ops)





    return WorldAIGenerateResponse(mode=req.mode, commands=all_commands, ops=all_ops, view=view)





@router.post("/simulation/run_step", response_model=SimulationStepResponse)


async def run_simulation_step(req: SimulationRunRequest, background_tasks: BackgroundTasks, current_user: User = Depends(get_current_user)):


    # Note: We don't strictly check ownership of every agent in the step here for simplicity,


    # but in a real app we should ensure the user has access to all agents involved.





    if req.current_step_index >= len(req.steps):


        raise HTTPException(status_code=400, detail="Step index out of range")





    step = req.steps[req.current_step_index]


    updated_state = req.world_state.copy()


    new_history_items = []





    def resolve_prompt(template, agent, history, state, use_rag: bool = True):


        if not template:


            return ""





        memory_text = ""


        if use_rag:


            memory_text = "\n".join(agent.get('long_term_memory', []))


        history_text = ""


        for h in history:


            history_text += f"{h.get('agent_name', 'Unknown')}: {h.get('content', '')}\n"


        last_output = history[-1].get('content', '') if history else ""





        try:


            t = Template(template)


            return t.render(


                memory=memory_text,


                history=history_text,


                last_output=last_output,


                state=state,


                agent=agent,


                str=str, # Add str to context


                int=int,


                len=len


            )


        except Exception as e:


            logging.error(f"Template render error: {e}")


            return template





    def extract_json(text):


        if not isinstance(text, str):


            return text


        match = re.search(r"```json\s*(.*?)\s*```", text, re.DOTALL)


        if match:


            return json.loads(match.group(1))


        match = re.search(r"```\s*(.*?)\s*```", text, re.DOTALL)


        if match:


            try:


                return json.loads(match.group(1))


            except:


                pass


        try:


            return json.loads(text)


        except:


            return text





    def _coerce_state_value(v):


        """Best-effort: coerce simple JSON/Python-literal strings into objects.





        This improves robustness for generated simulations where list/dict/numeric


        variables may arrive as strings.


        """


        if not isinstance(v, str):


            return v


        s = v.strip()


        if not s:


            return v


        # Avoid expensive parsing on very large blobs (e.g., embedded documents).


        if len(s) > 5000:


            return v





        # JSON objects/arrays


        if s[0] in "[{":


            try:


                return json.loads(s)


            except Exception:


                try:


                    return ast.literal_eval(s)


                except Exception:


                    return v





        # JSON booleans/null


        if s in {"true", "false", "null"}:


            try:


                return json.loads(s)


            except Exception:


                return v





        # Numbers (int/float/scientific)


        if re.fullmatch(r"[-+]?(?:\d+\.?\d*|\d*\.?\d+)(?:[eE][-+]?\d+)?", s):


            try:


                num = float(s)


                if num.is_integer() and "e" not in s.lower() and "." not in s:


                    return int(num)


                return num


            except Exception:


                return v





        return v





    def _get_user_agents(exclude_ids: List[str] = None) -> List[Dict]:


        exclude_ids = exclude_ids or []


        return [a for a in AGENTS_DB.values() if a.get('user_id') == current_user.username and a.get('id') not in exclude_ids]





    def _json_sanitize(obj):


        """Ensure the object is JSON-serializable (best-effort).





        Simulations sometimes put non-serializable objects into state (e.g., code


        objects). If we return them as-is, FastAPI will raise 500 on response


        serialization. We convert unknown objects to strings.


        """


        try:


            return json.loads(json.dumps(obj, ensure_ascii=False, default=str))


        except Exception:


            # As a last resort, stringify the entire object.


            return str(obj)





    def _invoke_agent_text(


        agent_id: str,


        prompt: str,


        files: Optional[List[str]] = None,


        force_no_files: bool = False,


        use_rag: bool = True,


    ):


        agent = AGENTS_DB.get(agent_id)


        if not agent:


            return "", ""





        relationships_desc = []


        for rel in RELATIONSHIPS_DB.values():


            if rel.get("user_id") == current_user.username:


                if rel['source_agent_id'] == agent_id:


                    target = AGENTS_DB.get(rel['target_agent_id'])


                    if target:


                        relationships_desc.append(f"You are {rel['relationship_type']} of {target['name']}.")


                elif rel['target_agent_id'] == agent_id:


                    source = AGENTS_DB.get(rel['source_agent_id'])


                    if source:


                        relationships_desc.append(f"{source['name']} is {rel['relationship_type']} of you.")





        messages = []


        persona = agent.get("persona")


        if relationships_desc:


            persona = (persona or "") + "\n\nRelationships:\n" + "\n".join(relationships_desc)





        # RAG retrieval (best-effort)


        memory_text = ""


        if use_rag:


            try:


                mem_agent = MemoryAgent(agent_id)


                relevant_memories = mem_agent.retrieve(prompt, count=3)


                memory_text = "\n".join(relevant_memories)


                simple_memories = agent.get('long_term_memory', [])


                if len(simple_memories) < 10:


                    memory_text = "\n".join(set(relevant_memories + simple_memories))


            except Exception as e:


                print(f"RAG Retrieval failed: {e}")


                memory_text = "\n".join(agent.get('long_term_memory', []))





        if memory_text:


            persona = (persona or "") + "\n\n[Long-term Memory / Context]:\n" + memory_text





        if persona:


            messages.append({"role": "system", "content": persona})





        file_paths = []


        if not force_no_files and files:


            for filename in files:


                file_path = f"uploads/{agent_id}/{filename}"


                if os.path.exists(file_path):


                    file_paths.append(file_path)





        response_content = ""


        try:


            provider = agent.get("provider")


            if provider in ["deepseek", "zhipu"]:


                res = ai_chat(


                    messages_or_prompt=messages,


                    prompt_content=prompt,


                    files=file_paths,


                    model=agent.get("model"),


                    api_key=agent.get("api_key"),


                    base_url=agent.get("base_url"),


                    temperature=0.7


                )


                response_content = res.get('content') or str(res)


            elif provider == "custom":


                custom_messages = prepare_multimodal_messages(messages, prompt, file_paths)


                code_str = agent.get("usage_example")


                local_scope = {"json": json}


                exec(code_str, local_scope)


                invoke_func = local_scope['invoke_custom_agent']


                res = invoke_func(


                    messages=custom_messages,


                    api_key=agent.get("api_key"),


                    base_url=agent.get("base_url"),


                    model=agent.get("model"),


                    temperature=0.7


                )


                if isinstance(res, dict):


                    content_val = res.get('content')


                    if content_val is None:


                        extracted = extract_content_from_raw(res)


                        response_content = extracted or str(res.get('raw') or res)


                    else:


                        response_content = content_val if isinstance(content_val, str) else json.dumps(content_val, ensure_ascii=False)


                else:


                    response_content = str(res)


            else:


                response_content = f"Error: Unsupported provider '{provider}'"


        except Exception as e:


            response_content = f"Error: {e}"





        # Save memory (only when enabled) + chat history for visibility


        if use_rag:


            try:


                background_save_memory(agent_id, prompt, response_content, step.id)


            except Exception:


                pass





        try:


            if agent_id not in CHAT_HISTORY_DB:


                CHAT_HISTORY_DB[agent_id] = []


            CHAT_HISTORY_DB[agent_id].append({"role": "user", "content": prompt, "timestamp": time.time()})


            CHAT_HISTORY_DB[agent_id].append({"role": "assistant", "content": response_content, "prompt": prompt, "memory_context": memory_text, "timestamp": time.time()})


            save_data("chat_history.json", CHAT_HISTORY_DB)


        except Exception:


            pass





        return response_content, memory_text





    if step.type == "code":


        try:


            # Common defaults for generated simulations.


            if "rng_seed" not in updated_state:


                updated_state["rng_seed"] = 12345





            # Best-effort coerce: if a state value looks like JSON/Python literal,


            # convert it to its native type before executing the snippet.


            for k in list(updated_state.keys()):


                updated_state[k] = _coerce_state_value(updated_state.get(k))





            local_scope = {


                "state": updated_state,


                "history": req.history,


                "json": json,


                "extract_json": extract_json,


                # Common stdlib modules used by generated snippets.


                "math": math,


                "random": random,


                "re": re,


                "statistics": statistics,


                "ast": ast,


            }





            # Capture stdout


            f = io.StringIO()


            with redirect_stdout(f):


                # Use a shared globals/locals dict so that imports and helper


                # functions defined in the snippet are visible to each other.


                # NOTE: Each step still runs in an isolated scope.


                exec(step.code_snippet, local_scope, local_scope)


            output_log = f.getvalue()





            # Calculate state changes


            changes = {}


            for k, v in updated_state.items():


                old_v = req.world_state.get(k)


                # Simple equality check


                if k not in req.world_state or str(old_v) != str(v):


                    changes[k] = {"old": old_v, "new": v}





            # Return structured change object


            response_content = json.dumps({


                "type": "state_change",


                "changes": changes,


                "stdout": output_log


            }, ensure_ascii=False, default=str)





            new_history_items.append({


                "step_id": step.id,


                "agent_name": "System",


                "content": response_content


            })


        except Exception as e:


            response_content = f"Error executing code: {e}"


            new_history_items.append({


                "step_id": step.id,


                "agent_name": "System",


                "content": response_content


            })





    elif step.type == "dialogue":


        target_agent_ids = step.agent_ids if step.agent_ids else ([step.agent_id] if step.agent_id else [])


        step_use_rag = getattr(step, 'use_rag', True)


        max_turns = getattr(step, 'dialogue_max_turns', None) or 6


        if max_turns < 1:


            max_turns = 1


        end_marker = getattr(step, 'dialogue_end_marker', None) or "END_DIALOGUE"


        auto_partner = getattr(step, 'dialogue_auto_partner', None)


        if auto_partner is None:


            auto_partner = True


        fixed_partner_id = getattr(step, 'dialogue_partner_id', None)





        dialogues_outputs = {}





        for initiator_id in target_agent_ids:


            initiator = AGENTS_DB.get(initiator_id)


            if not initiator or initiator.get('user_id') != current_user.username:


                continue





            candidates = _get_user_agents(exclude_ids=[initiator_id])


            if not candidates:


                continue





            partner_id = None


            if not auto_partner and fixed_partner_id:


                partner_id = fixed_partner_id


            else:


                # Ask initiator to pick a partner


                candidates_str = "\n".join([f"- {c.get('name')} (id: {c.get('id')})" for c in candidates])


                pick_prompt = (


                    "You are about to decide who to talk to next.\n"


                    "Pick exactly one partner from the list and respond ONLY with JSON like: {\"partner_id\":\"...\"}.\n\n"


                    f"Candidates:\n{candidates_str}"


                )


                pick_res, _ = _invoke_agent_text(


                    initiator_id,


                    pick_prompt,


                    force_no_files=True,


                    use_rag=step_use_rag,


                )


                try:


                    parsed = extract_json(pick_res)


                    if isinstance(parsed, dict) and parsed.get('partner_id'):


                        partner_id = parsed.get('partner_id')


                except Exception:


                    partner_id = None





                if not partner_id:


                    # Fallback: try to match by id or name


                    for c in candidates:


                        if c.get('id') and c.get('id') in str(pick_res):


                            partner_id = c.get('id')


                            break


                    if not partner_id:


                        for c in candidates:


                            if c.get('name') and c.get('name') in str(pick_res):


                                partner_id = c.get('id')


                                break


                if not partner_id:


                    partner_id = candidates[0].get('id')





            partner = AGENTS_DB.get(partner_id) if partner_id else None


            if not partner or partner.get('user_id') != current_user.username:


                continue





            initiator_name = initiator.get('name')


            partner_name = partner.get('name')





            # Start dialogue based on step prompt_template


            start_instruction = resolve_prompt(


                step.prompt_template,


                initiator,


                req.history,


                updated_state,


                use_rag=step_use_rag,


            )


            if not start_instruction:


                start_instruction = "Start a conversation that helps progress the simulation."





            transcript_lines = []


            convo_so_far = ""





            for turn in range(max_turns):


                speaker_id = initiator_id if turn % 2 == 0 else partner_id


                listener_name = partner_name if speaker_id == initiator_id else initiator_name


                speaker_name = initiator_name if speaker_id == initiator_id else partner_name





                if turn == 0:


                    prompt = (


                        f"You are {speaker_name}. You decided to talk to {listener_name}.\n"


                        f"Goal / instruction:\n{start_instruction}\n\n"


                        f"Write only what you say. If the conversation should end, include the exact token: {end_marker}"


                    )


                else:


                    prompt = (


                        f"You are {speaker_name} speaking to {listener_name}.\n"


                        f"Conversation so far:\n{convo_so_far}\n\n"


                        f"Continue the conversation. Write only what you say. If the conversation should end now, include the exact token: {end_marker}"


                    )





                resp, mem_ctx = _invoke_agent_text(


                    speaker_id,


                    prompt,


                    files=step.files,


                    use_rag=step_use_rag,


                )


                if not isinstance(resp, str):


                    resp = str(resp)


                ended = end_marker in resp


                clean_resp = resp.replace(end_marker, '').strip()





                transcript_lines.append(f"{speaker_name}: {clean_resp}")


                convo_so_far = "\n".join(transcript_lines)





                history_item = {


                    "step_id": step.id,


                    "agent_name": speaker_name,


                    "content": clean_resp,


                    "prompt": prompt,


                    "memory_context": mem_ctx,


                    "files": step.files,


                    "world_state": updated_state.copy()


                }


                new_history_items.append(history_item)





                # Make dialogue visible to subsequent steps if serial execution is desired


                if getattr(step, 'execution_mode', 'parallel') == 'serial':


                    req.history.append({"agent_name": speaker_name, "content": clean_resp})





                if ended:


                    break





            dialogues_outputs[f"{initiator_name}↔{partner_name}"] = "\n".join(transcript_lines)





        if step.output_var:


            final_output_var = resolve_prompt(step.output_var, {}, [], updated_state, use_rag=False)


            if len(dialogues_outputs) == 1:


                updated_state[final_output_var] = list(dialogues_outputs.values())[0]


            else:


                updated_state[final_output_var] = dialogues_outputs





    else:


        target_agent_ids = step.agent_ids if step.agent_ids else ([step.agent_id] if step.agent_id else [])


        combined_outputs = {}





        for agent_id in target_agent_ids:


            agent = AGENTS_DB.get(agent_id)


            if not agent:


                continue


            # Check ownership? For now, if agent exists, we allow it.


            # Ideally: if agent.get("user_id") != current_user.username: continue





            use_rag = getattr(step, 'use_rag', True)


            prompt = resolve_prompt(step.prompt_template, agent, req.history, updated_state, use_rag=use_rag)





            relationships_desc = []


            for rel in RELATIONSHIPS_DB.values():


                if rel.get("user_id") == current_user.username:


                    if rel['source_agent_id'] == agent_id:


                        target = AGENTS_DB.get(rel['target_agent_id'])


                        if target:


                            relationships_desc.append(f"You are {rel['relationship_type']} of {target['name']}.")


                    elif rel['target_agent_id'] == agent_id:


                        source = AGENTS_DB.get(rel['source_agent_id'])


                        if source:


                            relationships_desc.append(f"{source['name']} is {rel['relationship_type']} of you.")





            messages = []


            persona = agent.get("persona")





            if relationships_desc:


                persona = (persona or "") + "\n\nRelationships:\n" + "\n".join(relationships_desc)





            # --- Auto-Inject Memory if not used in prompt ---


            # If the user didn't explicitly use {{memory}} in the prompt template,


            # we append the memory to the system persona so the agent is still aware of it.





            # RAG Retrieval


            memory_text = ""





            if use_rag:


                try:


                    mem_agent = MemoryAgent(agent_id)


                    # Retrieve top 3 relevant memories based on the current prompt


                    relevant_memories = mem_agent.retrieve(prompt, count=3)


                    memory_text = "\n".join(relevant_memories)





                    # Fallback to simple list if RAG returns nothing (or add both?)


                    # For now, let's combine them to ensure nothing is lost, but prioritize RAG


                    simple_memories = agent.get('long_term_memory', [])


                    # If simple memories are small, just add them all. If large, rely on RAG.


                    if len(simple_memories) < 10:


                        all_memories = set(relevant_memories + simple_memories)


                        memory_text = "\n".join(all_memories)


                except Exception as e:


                    print(f"RAG Retrieval failed: {e}")


                    memory_text = "\n".join(agent.get('long_term_memory', []))





            if use_rag and memory_text and "{{memory}}" not in (step.prompt_template or ""):


                persona = (persona or "") + "\n\n[Long-term Memory / Context]:\n" + memory_text


            # ------------------------------------------------





            if persona:


                messages.append({"role": "system", "content": persona})





            file_paths = []


            if step.files:


                for filename in step.files:


                    file_path = f"uploads/{agent_id}/{filename}"


                    if os.path.exists(file_path):


                        file_paths.append(file_path)





            # --- Auto-detect local image paths in prompt ---


            # If the prompt contains a local file path (e.g. from a previous step's output),


            # automatically add it to the file_paths list so it gets attached as an image.


            try:


                # 1. Windows Absolute Paths


                candidates = re.findall(r'([a-zA-Z]:\\[^:<>"|?*\n\r]+\.(?:png|jpg|jpeg|gif|webp|bmp))', prompt, re.IGNORECASE)


                for path in candidates:


                    clean_path = path.strip()


                    if os.path.exists(clean_path) and clean_path not in file_paths:


                        file_paths.append(clean_path)


                        print(f"Auto-attached local image found in prompt: {clean_path}")





                # 2. Web Paths (e.g. /uploads/generated/...)


                web_candidates = re.findall(r'(/uploads/[^:<>"|?*\n\r]+\.(?:png|jpg|jpeg|gif|webp|bmp))', prompt, re.IGNORECASE)


                for path in web_candidates:


                    # Resolve relative web path to absolute server path


                    # Assuming CWD is the backend root where 'uploads' folder exists


                    clean_path = path.strip().lstrip('/') # Remove leading slash


                    abs_path = os.path.abspath(clean_path)


                    if os.path.exists(abs_path) and abs_path not in file_paths:


                        file_paths.append(abs_path)


                        print(f"Auto-attached web image found in prompt: {abs_path}")





            except Exception as e:


                print(f"Error detecting files in prompt: {e}")


            # -----------------------------------------------





            response_content = ""


            try:


                provider = agent.get("provider")


                if provider in ["deepseek", "zhipu"]:


                    res = ai_chat(


                        messages_or_prompt=messages,


                        prompt_content=prompt,


                        files=file_paths,


                        model=agent.get("model"),


                        api_key=agent.get("api_key"),


                        base_url=agent.get("base_url"),


                        temperature=0.7


                    )


                    response_content = res.get('content') or str(res)


                elif provider == "custom":


                    # For custom agents, we must manually append the user prompt to messages


                    # because invoke_custom_agent expects a full list of messages.


                    # We use prepare_multimodal_messages to handle text and files robustly.


                    custom_messages = prepare_multimodal_messages(messages, prompt, file_paths)





                    # DEBUG: Log the payload being sent to custom agent


                    print(f"Invoking Custom Agent: {agent.get('name')}")


                    # print(f"Messages Payload: {json.dumps(custom_messages, default=str)[:500]}...")





                    code_str = agent.get("usage_example")


                    local_scope = {"json": json}


                    exec(code_str, local_scope)


                    invoke_func = local_scope['invoke_custom_agent']


                    res = invoke_func(


                        messages=custom_messages,


                        api_key=agent.get("api_key"),


                        base_url=agent.get("base_url"),


                        model=agent.get("model"),


                        temperature=0.7


                    )





                    # Robustly handle response content (string, dict, or list)


                    if isinstance(res, dict):


                        content_val = res.get('content')


                        if not content_val: # Handles None and empty string


                             # Try to extract content using adapter logic first


                             extracted = extract_content_from_raw(res)


                             if extracted:


                                 response_content = extracted


                             # If content is empty, try to return the whole dict so user can see raw output (including images in 'raw')


                             # But prefer 'raw' if available and content is empty


                             elif res.get('raw'):


                                 response_content = str(res['raw'])


                             else:


                                 response_content = str(res)


                        elif isinstance(content_val, (dict, list)):


                             response_content = json.dumps(content_val, ensure_ascii=False)


                        else:


                             response_content = str(content_val)


                    else:


                        response_content = str(res)


            except Exception as e:


                response_content = f"Error: {e}"





            # --- Auto-Poll for Async Video Tasks (Robust / Universal) ---


            # 1. Check if the custom agent returned an explicit 'async_task_id'


            # 2. Or fallback to regex pattern matching


            task_id = None


            # Ensure res is defined and safe to access


            safe_res = res if 'res' in locals() else {}





            if isinstance(safe_res, dict) and safe_res.get('async_task_id'):


                task_id = safe_res.get('async_task_id')


            else:


                task_match = re.search(r"Task ID:\s*([a-f0-9\-]+)", response_content, re.IGNORECASE)


                if task_match:


                    task_id = task_match.group(1)





            if task_id:


                print(f"Detected Async Task ID: {task_id}. Starting polling...")





                api_key = agent.get("api_key")


                base_url = agent.get("base_url") or ""





                # Check if the generated code provided a polling function


                poll_func = local_scope.get('poll_custom_task') if 'local_scope' in locals() else None





                start_time = time.time()


                # Polling loop (max 5 minutes)


                while time.time() - start_time < 300:


                    try:


                        video_url = None


                        fail_msg = ""


                        is_finished = False





                        if poll_func:


                            # Use the generated polling function (Most Robust)


                            try:


                                poll_res = poll_func(task_id, api_key, base_url)


                                status_code = poll_res.get('status')


                                if status_code in ['SUCCESS', 'SUCCEEDED', 'completed']:


                                    video_url = poll_res.get('video_url')


                                    is_finished = True


                                elif status_code in ['FAILED', 'CANCELED', 'FAIL']:


                                    fail_msg = poll_res.get('error', 'Unknown error')


                                    is_finished = True


                            except Exception as pe:


                                print(f"Custom polling function error: {pe}")


                                # Fallback to default logic if custom function crashes


                                poll_func = None





                        if not poll_func:


                            # Fallback: Default Polling Logic (Strict Check)


                            poll_url = ""


                            headers = {"Authorization": f"Bearer {api_key}"}





                            if "bigmodel.cn" in base_url or agent.get("provider") == "zhipu":


                                poll_url = f"https://open.bigmodel.cn/api/paas/v4/async-result/{task_id}"


                                # Zhipu Logic


                                poll_res = requests.get(poll_url, headers=headers)


                                if poll_res.status_code == 200:


                                    task_data = poll_res.json()


                                    task_status = task_data.get("task_status", "")


                                    if task_status == "SUCCESS":


                                        video_result = task_data.get("video_result", [])


                                        if video_result: video_url = video_result[0].get("url")


                                        is_finished = True


                                    elif task_status == "FAIL":


                                        fail_msg = str(task_data)


                                        is_finished = True





                            elif "dashscope" in base_url or "aliyun" in base_url:


                                poll_url = f"https://dashscope.aliyuncs.com/api/v1/tasks/{task_id}"


                                # DashScope Logic


                                poll_res = requests.get(poll_url, headers=headers)


                                if poll_res.status_code == 200:


                                    task_data = poll_res.json()


                                    task_status = task_data.get("output", {}).get("task_status", "")


                                    if task_status == "SUCCEEDED":


                                        output = task_data.get("output", {})


                                        video_url = output.get("video_url")


                                        if not video_url and "results" in output:


                                            res_list = output["results"]


                                            if res_list: video_url = res_list[0].get("url")


                                        is_finished = True


                                    elif task_status in ["FAILED", "CANCELED"]:


                                        fail_msg = task_data.get('output', {}).get('message', 'Unknown error')


                                        is_finished = True


                            else:


                                # Unknown Provider and No Custom Polling Function


                                fail_msg = "No polling logic found for this provider. Please regenerate the adapter code."


                                is_finished = True





                        # Check Final Status


                        if is_finished:


                            if video_url:


                                print(f"Task Succeeded. Video URL: {video_url}")


                                response_content = json.dumps([{


                                    "type": "video_url",


                                    "video_url": {"url": video_url}


                                }])


                            else:


                                response_content = f"[Video Generation Failed/Skipped: {fail_msg}]"


                                if "regenerate" in fail_msg:


                                    response_content += "\n\n(Action Required: Go to Agent Edit -> Custom Adapter -> Click 'Generate Adapter Code' to enable auto-polling for this model.)"


                            break





                        time.sleep(5)


                    except Exception as e:


                        print(f"Polling error: {e}")


                        time.sleep(5)


            # -------------------------------------------------------





            new_history_items.append({


                "step_id": step.id,


                "agent_name": agent.get("name"),


                "content": response_content,


                "prompt": prompt,


                "memory_context": memory_text,


                "files": step.files,


                "world_state": updated_state.copy()


            })





            # --- Serial Execution Support ---


            if getattr(step, 'execution_mode', 'parallel') == 'serial':


                req.history.append({


                    "agent_name": agent.get("name"),


                    "content": response_content


                })


            # --------------------------------





            # --- Background Memory Save ---


            # Save Q&A to memory only when enabled (use_rag=True)


            if use_rag:


                print(f"DEBUG: Saving memory for agent {agent_id}")


                background_save_memory(agent_id, prompt, response_content, step.id)





            # --- Save Chat History Step-by-Step ---


            print(f"DEBUG: Saving chat history for agent {agent_id}")


            if agent_id not in CHAT_HISTORY_DB:


                CHAT_HISTORY_DB[agent_id] = []





            # Add User Prompt


            CHAT_HISTORY_DB[agent_id].append({


                "role": "user",


                "content": prompt,


                "timestamp": time.time()


            })





            # Add Agent Response


            CHAT_HISTORY_DB[agent_id].append({


                "role": "assistant",


                "content": response_content,


                "prompt": prompt, # Redundant but kept for compatibility


                "memory_context": memory_text,


                "timestamp": time.time()


            })


            save_data("chat_history.json", CHAT_HISTORY_DB)


            print(f"DEBUG: Chat history saved. DB size: {len(CHAT_HISTORY_DB[agent_id])}")


            # --------------------------------------





            combined_outputs[agent.get("name")] = response_content





        if step.output_var:


            # Resolve output_var if it contains templates (Dynamic Keys)


            # We use a dummy agent/history context since output_var usually only depends on state


            final_output_var = resolve_prompt(step.output_var, {}, [], updated_state, use_rag=False)





            # Process outputs based on requested format


            processed_outputs = {}


            fmt = step.output_format or 'raw'





            for agent_name, content in combined_outputs.items():


                val = content


                if fmt == 'text':


                    try:


                        if content.strip().startswith('[') or content.strip().startswith('{'):


                            parsed = json.loads(content)


                            if isinstance(parsed, list):


                                texts = [p.get('text', '') for p in parsed if p.get('type') == 'text']


                                val = "\n".join(texts).strip()


                    except:


                        pass


                elif fmt == 'raw':


                    # Robustness: Try to parse JSON if the content looks like it


                    val = extract_json(content)


                elif fmt == 'image':


                    found = False


                    try:


                        if content.strip().startswith('[') or content.strip().startswith('{'):


                            parsed = json.loads(content)


                            if isinstance(parsed, list):


                                for p in parsed:


                                    if p.get('type') == 'image_url':


                                        val = p['image_url']['url']


                                        found = True


                                        break


                    except:


                        pass





                    if not found:


                        # Try regex for markdown image


                        match = re.search(r'!\[.*?\]\((.*?)\)', content)


                        if match:


                            val = match.group(1)





                # Auto-download image if format is 'image' and it's a remote URL


                if fmt == 'image' and val and isinstance(val, str) and val.startswith('http'):


                    try:


                        save_dir = "uploads/generated"


                        os.makedirs(save_dir, exist_ok=True)





                        # Guess extension


                        ext = "png"


                        if "." in val.split("/")[-1]:


                            possible = val.split("/")[-1].split(".")[-1].split("?")[0]


                            if possible.lower() in ['jpg', 'jpeg', 'png', 'gif', 'webp']:


                                ext = possible.lower()





                        filename = f"{uuid.uuid4()}.{ext}"


                        local_path = os.path.abspath(os.path.join(save_dir, filename))





                        # Download


                        print(f"Downloading image from {val} to {local_path}...")


                        dl_res = requests.get(val, timeout=30)


                        if dl_res.status_code == 200:


                            with open(local_path, 'wb') as f:


                                f.write(dl_res.content)


                            # Store Web Path (Relative) instead of Absolute Path


                            # This allows frontend to display it and backend to resolve it later


                            val = f"/uploads/generated/{filename}"


                            print("Download successful.")


                        else:


                            print(f"Download failed: {dl_res.status_code}")


                    except Exception as e:


                        print(f"Failed to download image: {e}")





                elif fmt == 'video':


                    # Try to extract video URL from JSON structure


                    try:


                        if content.strip().startswith('[') or content.strip().startswith('{'):


                            parsed = json.loads(content)


                            if isinstance(parsed, list):


                                for p in parsed:


                                    if p.get('type') == 'video_url':


                                        val = p['video_url']['url']


                                        break


                    except:


                        pass





                elif fmt == 'audio':


                    # Try to extract audio URL from JSON structure


                    try:


                        if content.strip().startswith('[') or content.strip().startswith('{'):


                            parsed = json.loads(content)


                            if isinstance(parsed, list):


                                for p in parsed:


                                    if p.get('type') == 'audio_url':


                                        val = p['audio_url']['url']


                                        break


                    except:


                        pass





                processed_outputs[agent_name] = val





            # Unwrap if single agent to make {{state.Var}} cleaner


            if len(processed_outputs) == 1:


                updated_state[final_output_var] = list(processed_outputs.values())[0]


            else:


                updated_state[final_output_var] = processed_outputs





    # Make sure we never return non-serializable state values.


    updated_state = _json_sanitize(updated_state)





    return SimulationStepResponse(


        content="Step executed",


        new_history_items=new_history_items,


        updated_world_state=updated_state


    )





@router.post("/relationships", response_model=RelationshipResponse)


async def create_relationship(rel: RelationshipCreateRequest, current_user: User = Depends(get_current_user)):


    if rel.source_agent_id not in AGENTS_DB or rel.target_agent_id not in AGENTS_DB:


        raise HTTPException(status_code=404, detail="One or both agents not found")





    # Verify ownership



        AGENTS_DB[rel.target_agent_id].get("user_id") != current_user.username:



        raise HTTPException(status_code=403, detail="Access denied to one or both agents")





    rel_id = str(uuid.uuid4())


    new_rel = {


        "id": rel_id,


        "user_id": current_user.username,


        **rel.dict()


    }


    RELATIONSHIPS_DB[rel_id] = new_rel


    save_data("relationships.json", RELATIONSHIPS_DB)


    return RelationshipResponse(**new_rel)





@router.get("/relationships", response_model=List[RelationshipResponse])


async def list_relationships(current_user: User = Depends(get_current_user)):


    return [RelationshipResponse(**r) for r in RELATIONSHIPS_DB.values() if r.get("user_id") == current_user.username]





@router.delete("/relationships/{rel_id}")


async def delete_relationship(rel_id: str, current_user: User = Depends(get_current_user)):


    rel = RELATIONSHIPS_DB.get(rel_id)


    if not rel or rel.get("user_id") != current_user.username:


        raise HTTPException(status_code=404, detail="Relationship not found")





    del RELATIONSHIPS_DB[rel_id]


    save_data("relationships.json", RELATIONSHIPS_DB)


    return {"message": "Deleted"}





@router.get("/agents/{agent_id}/history")


async def get_agent_history(agent_id: str, limit: int = 100, offset: int = 0, current_user: User = Depends(get_current_user)):


    agent = AGENTS_DB.get(agent_id)


    if not agent or agent.get("user_id") != current_user.username:


        raise HTTPException(status_code=404, detail="Agent not found")


    history = history[offset:offset+limit]
    return CHAT_HISTORY_DB.get(agent_id, [])





@router.post("/agents/{agent_id}/history")


async def add_agent_history(agent_id: str, message: Dict[str, str], current_user: User = Depends(get_current_user)):


    agent = AGENTS_DB.get(agent_id)


    if not agent or agent.get("user_id") != current_user.username:


        raise HTTPException(status_code=404, detail="Agent not found")





    if agent_id not in CHAT_HISTORY_DB:


        CHAT_HISTORY_DB[agent_id] = []


    CHAT_HISTORY_DB[agent_id].append(message)


    save_data("chat_history.json", CHAT_HISTORY_DB)


    return {"message": "History added"}





@router.delete("/agents/{agent_id}/history")


async def clear_agent_history(agent_id: str, current_user: User = Depends(get_current_user)):


    agent = AGENTS_DB.get(agent_id)


    if not agent or agent.get("user_id") != current_user.username:


        raise HTTPException(status_code=404, detail="Agent not found")





    CHAT_HISTORY_DB[agent_id] = []


    save_data("chat_history.json", CHAT_HISTORY_DB)


    return {"message": "History cleared"}





@router.post("/agents/{agent_id}/history/delete_batch")


async def delete_agent_history_batch(agent_id: str, indices: List[int], current_user: User = Depends(get_current_user)):


    agent = AGENTS_DB.get(agent_id)


    if not agent or agent.get("user_id") != current_user.username:


        raise HTTPException(status_code=404, detail="Agent not found")





    if agent_id not in CHAT_HISTORY_DB:


        return {"message": "No history to delete"}





    # Sort indices in descending order to avoid shifting issues


    indices.sort(reverse=True)





    history = CHAT_HISTORY_DB[agent_id]


    for idx in indices:


        if 0 <= idx < len(history):


            history.pop(idx)





    save_data("chat_history.json", CHAT_HISTORY_DB)


    return {"message": "Selected history items deleted"}





@router.post("/chat")


async def chat_with_agent(request: ChatRequest, background_tasks: BackgroundTasks, current_user: User = Depends(get_current_user)):


    agent = AGENTS_DB.get(request.agent_id)


    if not agent or agent.get("user_id") != current_user.username:


        raise HTTPException(status_code=404, detail="Agent not found")





    provider = agent.get("provider")


    messages = request.messages


    persona = agent.get("persona")


    if persona:


        if messages and messages[0].get('role') == 'system':


            pass


        else:


            messages = [{"role": "system", "content": persona}] + messages





    # Helper to extract last user message for memory context


    last_user_msg = ""


    for m in reversed(request.messages):


        if m.get('role') == 'user':


            last_user_msg = m.get('content', '')


            break





    if provider in ["deepseek", "zhipu"]:


        response = ai_chat(


            messages_or_prompt=messages,


            model=agent.get("model"),


            api_key=agent.get("api_key"),


            base_url=agent.get("base_url"),


            temperature=request.temperature,


            max_tokens=request.max_tokens


        )





        # Background Memory Save


        content = response.get('content') or str(response)


        background_tasks.add_task(background_save_memory, request.agent_id, last_user_msg, content)





        return response





    elif provider == "custom":


        code_str = agent.get("usage_example")


        if not code_str:


             raise HTTPException(status_code=400, detail="No custom code provided for custom agent")





        local_scope = {}


        try:


            exec(code_str, local_scope)


            if 'invoke_custom_agent' not in local_scope:


                 raise HTTPException(status_code=500, detail="Custom code must define 'invoke_custom_agent'")





            invoke_func = local_scope['invoke_custom_agent']


            result = invoke_func(


                messages=messages,


                api_key=agent.get("api_key"),


                base_url=agent.get("base_url"),


                model=agent.get("model"),


                temperature=request.temperature


            )





            # --- Auto-Poll for Async Video Tasks (Robust / Universal) ---


            task_id = None


            if isinstance(result, dict) and result.get('async_task_id'):


                task_id = result.get('async_task_id')


            else:


                # Try to find Task ID in content


                content_str = str(result.get('content', '')) if isinstance(result, dict) else str(result)


                task_match = re.search(r"Task ID:\s*([a-f0-9\-]+)", content_str, re.IGNORECASE)


                if task_match:


                    task_id = task_match.group(1)





            if task_id:


                # ... (Polling logic omitted for brevity, assuming it updates result['content']) ...


                pass





            # Background Memory Save (Custom)


            # Note: If async polling happens, we might save the "Task ID" message first.


            # Ideally we should save the FINAL video URL, but that happens inside the polling loop which is blocking here?


            # Wait, the polling loop IS blocking here (up to 300s).


            # So 'result' will contain the final content.


            final_content = result.get('content') if isinstance(result, dict) else str(result)


            background_tasks.add_task(background_save_memory, request.agent_id, last_user_msg, final_content)





            return result


        except Exception as e:


            import traceback


            traceback.print_exc()


            raise HTTPException(status_code=500, detail=f"Custom agent execution failed: {e}")





    else:


        raise HTTPException(status_code=400, detail="Unknown provider")





@router.get("/simulations", response_model=List[Simulation])


async def list_simulations(current_user: User = Depends(get_current_user)):





    def _has_access(sim: Dict[str, Any], username: str) -> bool:


        if not isinstance(sim, dict):


            return False


        if sim.get("user_id") == username:


            return True


        shared_with = sim.get("shared_with")


        return isinstance(shared_with, list) and username in shared_with





    return [Simulation(**s) for s in SIMULATIONS_DB.values() if _has_access(s, current_user.username)]








@router.post("/simulations/{sim_id}/share")


async def share_simulation(sim_id: str, payload: Dict[str, Any], current_user: User = Depends(get_current_user)):


    """Share a simulation with another user (read-only for the recipient).





    payload:


      {"username": "prm"}


    or


      {"usernames": ["prm", "alice"]}


    """


    sim = SIMULATIONS_DB.get(sim_id)


    if not sim:


        raise HTTPException(status_code=404, detail="Simulation not found")


    if sim.get("user_id") != current_user.username:


        raise HTTPException(status_code=403, detail="Access denied")





    usernames: List[str] = []


    if isinstance(payload, dict):


        if isinstance(payload.get("username"), str) and payload.get("username").strip():


            usernames.append(payload.get("username").strip())


        if isinstance(payload.get("usernames"), list):


            for u in payload.get("usernames"):


                if isinstance(u, str) and u.strip():


                    usernames.append(u.strip())


    usernames = sorted(list({u for u in usernames if u and u != current_user.username}))


    if not usernames:


        raise HTTPException(status_code=400, detail="Missing username(s)")





    shared_with = sim.get("shared_with")


    if not isinstance(shared_with, list):


        shared_with = []





    changed = False


    for u in usernames:


        if u not in shared_with:


            shared_with.append(u)


            changed = True


    sim["shared_with"] = shared_with


    SIMULATIONS_DB[sim_id] = sim


    if changed:


        save_data("simulations.json", SIMULATIONS_DB)


    return {"message": "Simulation shared", "sim_id": sim_id, "shared_with": shared_with}








@router.post("/simulations/{sim_id}/unshare")


async def unshare_simulation(sim_id: str, payload: Dict[str, Any], current_user: User = Depends(get_current_user)):


    """Remove a share grant. payload: {"username":"prm"} or {"usernames":[...]}"""


    sim = SIMULATIONS_DB.get(sim_id)


    if not sim:


        raise HTTPException(status_code=404, detail="Simulation not found")


    if sim.get("user_id") != current_user.username:


        raise HTTPException(status_code=403, detail="Access denied")





    usernames: List[str] = []


    if isinstance(payload, dict):


        if isinstance(payload.get("username"), str) and payload.get("username").strip():


            usernames.append(payload.get("username").strip())


        if isinstance(payload.get("usernames"), list):


            for u in payload.get("usernames"):


                if isinstance(u, str) and u.strip():


                    usernames.append(u.strip())


    usernames = list({u for u in usernames if u})


    if not usernames:


        raise HTTPException(status_code=400, detail="Missing username(s)")





    shared_with = sim.get("shared_with")


    if not isinstance(shared_with, list):


        shared_with = []


    before = list(shared_with)


    shared_with = [u for u in shared_with if u not in set(usernames)]


    sim["shared_with"] = shared_with


    SIMULATIONS_DB[sim_id] = sim


    if before != shared_with:


        save_data("simulations.json", SIMULATIONS_DB)


    return {"message": "Simulation unshared", "sim_id": sim_id, "shared_with": shared_with}





@router.post("/simulations/upload_temp")


async def upload_simulation_temp_file(file: UploadFile = File(...), current_user: User = Depends(get_current_user)):


    upload_dir = "uploads/temp"


    os.makedirs(upload_dir, exist_ok=True)





    # Sanitize filename


    filename = os.path.basename(file.filename)


    file_path = f"{upload_dir}/{filename}"





    with open(file_path, "wb") as buffer:


        shutil.copyfileobj(file.file, buffer)





    return {"filename": filename, "message": "File uploaded to temp storage"}





@router.post("/simulations/generate", response_model=Simulation)


async def generate_simulation(request: SimulationGenerateRequest, current_user: User = Depends(get_current_user)):


    try:


        # Robustness: If file_content is missing but files are provided, try to extract text


        file_content = request.file_content


        if not file_content and request.file_names:


            temp_dir = "uploads/temp"


            # Try multiple files (in order) and concatenate, capped to avoid huge prompts.


            # This makes "attach references" actually useful for the Architect.


            chunks = []


            total = 0


            max_chars = 50000


            for fn in (request.file_names or [])[:5]:


                file_path = f"{temp_dir}/{fn}"


                if not os.path.exists(file_path):


                    continue


                try:


                    print(f"Extracting text from {file_path} for Architect...")


                    t = extract_text_from_file(file_path) or ""


                except Exception as _e:


                    t = ""


                if not t:


                    continue





                header = f"\n\n--- File: {fn} ---\n"


                footer = "\n--- End of File ---\n"


                remaining = max_chars - total


                if remaining <= 0:


                    break


                piece = (header + t + footer)


                if len(piece) > remaining:


                    piece = piece[:remaining] + "\n[...Truncated...]\n"


                chunks.append(piece)


                total += len(piece)


                if total >= max_chars:


                    break





            file_content = "".join(chunks).strip() if chunks else file_content





        config = generate_simulation_config(request.prompt, file_content, request.file_names)





        # --- Auto-create missing agents ---


        all_agent_ids = set()


        def extract_ids(steps):


            for step in steps:


                if step.get('type') == 'agent':


                    ids = step.get('agent_ids', [])


                    if isinstance(ids, list):


                        for i in ids: all_agent_ids.add(i)


                if step.get('inner_steps'):


                    extract_ids(step['inner_steps'])





        extract_ids(config.get("steps", []))





        missing_ids = [aid for aid in all_agent_ids if aid not in AGENTS_DB]





        if missing_ids:


            # Find template (first agent of this user)


            template_agent = None


            for agent in AGENTS_DB.values():


                if agent.get("user_id") == current_user.username:


                    template_agent = agent


                    break





            if template_agent:


                for aid in missing_ids:


                    new_agent = template_agent.copy()


                    new_agent['id'] = aid


                    new_agent['name'] = aid.replace("-", " ").replace("_", " ").title()


                    new_agent['persona'] = f"You are {new_agent['name']}."


                    new_agent['user_id'] = current_user.username


                    new_agent['long_term_memory'] = [] # Reset memory


                    AGENTS_DB[aid] = new_agent


                    print(f"Auto-created agent: {new_agent['name']} ({aid})")


                save_data("agents.json", AGENTS_DB)


        # ----------------------------------





        # --- Distribute Temp Files to Agents ---


        if request.file_names:


            temp_dir = "uploads/temp"





            def distribute_files(steps):


                for step in steps:


                    # Check if step uses any of the temp files


                    step_files = step.get('files', [])


                    if not step_files: continue





                    # Find intersection


                    files_to_copy = [f for f in step_files if f in request.file_names]





                    if files_to_copy:


                        agent_ids = step.get('agent_ids', [])


                        for aid in agent_ids:


                            agent = AGENTS_DB.get(aid)


                            if not agent: continue





                            agent_upload_dir = f"uploads/{aid}"


                            os.makedirs(agent_upload_dir, exist_ok=True)





                            for fname in files_to_copy:


                                src = f"{temp_dir}/{fname}"


                                dst = f"{agent_upload_dir}/{fname}"


                                if os.path.exists(src):


                                    shutil.copy2(src, dst)


                                    # Update agent record


                                    if 'files' not in agent: agent['files'] = []


                                    if fname not in agent['files']:


                                        agent['files'].append(fname)





                            AGENTS_DB[aid] = agent





                    if step.get('inner_steps'):


                        distribute_files(step['inner_steps'])





            distribute_files(config.get("steps", []))


            save_data("agents.json", AGENTS_DB)


        # ---------------------------------------





        # Convert raw dict to Simulation model to validate


        # We generate a temporary ID and user_id


        # Robustness: Ensure variables[*].value is always a string (the Pydantic model requires Dict[str, str]).


        normalized_vars = []


        for v in (config.get("variables", []) or []):


            if not isinstance(v, dict):


                continue


            vv = dict(v)


            if "value" in vv and not isinstance(vv.get("value"), str):


                try:


                    vv["value"] = json.dumps(vv.get("value"), ensure_ascii=False)


                except Exception:


                    vv["value"] = str(vv.get("value"))


            # Some LLMs may omit value; keep type stable.


            if "value" not in vv:


                vv["value"] = ""


            # Ensure key exists to avoid downstream issues


            if "key" not in vv:


                continue


            normalized_vars.append(vv)





        sim_data = {


            "id": str(uuid.uuid4()),


            "name": config.get("name", "Generated Simulation"),


            "description": config.get("description", ""),


            "steps": config.get("steps", []),


            "variables": normalized_vars,


            "user_id": current_user.username


        }





        return Simulation(**sim_data)


    except Exception as e:


        logging.error(f"Simulation generation failed: {e}")


        raise HTTPException(status_code=500, detail=str(e))





@router.post("/simulations", response_model=Simulation)


async def create_simulation(sim: Simulation, current_user: User = Depends(get_current_user)):


    sim_id = str(uuid.uuid4())


    new_sim = sim.dict()


    new_sim['id'] = sim_id


    new_sim['user_id'] = current_user.username


    SIMULATIONS_DB[sim_id] = new_sim


    save_data("simulations.json", SIMULATIONS_DB)


    return Simulation(**new_sim)





@router.get("/simulations/{sim_id}", response_model=Simulation)


async def get_simulation(sim_id: str, current_user: User = Depends(get_current_user)):


    sim = SIMULATIONS_DB.get(sim_id)





    def _has_access(sim_obj: Dict[str, Any], username: str) -> bool:


        if not isinstance(sim_obj, dict):


            return False


        if sim_obj.get("user_id") == username:


            return True


        shared_with = sim_obj.get("shared_with")


        return isinstance(shared_with, list) and username in shared_with





    if not sim or not _has_access(sim, current_user.username):


        raise HTTPException(status_code=404, detail="Simulation not found")


    return Simulation(**sim)





@router.put("/simulations/{sim_id}", response_model=Simulation)


async def update_simulation(sim_id: str, sim: Simulation, current_user: User = Depends(get_current_user)):


    if sim_id not in SIMULATIONS_DB:


        raise HTTPException(status_code=404, detail="Simulation not found")





    existing = SIMULATIONS_DB[sim_id]


    if existing.get("user_id") != current_user.username:


        raise HTTPException(status_code=403, detail="Access denied")





    updated_sim = sim.dict()


    updated_sim['id'] = sim_id


    updated_sim['user_id'] = current_user.username


    # Preserve share grants (recipient read-access)


    if isinstance(existing.get("shared_with"), list):


        updated_sim["shared_with"] = existing.get("shared_with")


    SIMULATIONS_DB[sim_id] = updated_sim


    save_data("simulations.json", SIMULATIONS_DB)


    return Simulation(**updated_sim)





@router.delete("/simulations/{sim_id}")


async def delete_simulation(sim_id: str, current_user: User = Depends(get_current_user)):


    if sim_id not in SIMULATIONS_DB:


        raise HTTPException(status_code=404, detail="Simulation not found")





    existing = SIMULATIONS_DB[sim_id]


    if existing.get("user_id") != current_user.username:


        raise HTTPException(status_code=403, detail="Access denied")





    del SIMULATIONS_DB[sim_id]


    save_data("simulations.json", SIMULATIONS_DB)


    return {"message": "Simulation deleted"}





